# ── BounceOS environment ───────────────────────────────────────────────
# Secrets belong in Railway variables / Infisical — never commit real values.

# Database (Railway Postgres). Omit locally to use embedded PGlite in ./.data
DATABASE_URL=
# AUTO_MIGRATE=true            # apply ./drizzle migrations on boot (default true)

# Hosts
PUBLIC_APP_URL=http://localhost:4321          # platform origin (app + marketing)
PLATFORM_HOSTS=localhost,127.0.0.1            # comma list, e.g. bounceos.app,www.bounceos.app
SITES_BASE_DOMAIN=localhost                   # free operator sites: {slug}.<this>, e.g. bounceos.site

# Security
SESSION_SECRET=                               # 32+ random bytes; signs demo payment links
CRON_SECRET=                                  # Bearer token for POST /api/cron/run

# Payments (Stripe Connect). Unset = demo mode with signed confirmation links
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ALLOW_DEMO_PAYMENTS=false

# Messaging (unset = messages are logged, not sent)
RESEND_API_KEY=
EMAIL_FROM=bookings@bounceos.app
TELNYX_API_KEY=
TELNYX_FROM=

# AI copy (unset = deterministic templates). Defaults to claude-opus-5-5
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
