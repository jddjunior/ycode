{
  "name": "bounceos",
  "version": "0.1.0",
  "private": true,
  "description": "BounceOS by Branch Avenue HQ — the operating system for bounce house & party rental businesses: booking, inventory, websites, SEO, marketing, ads, socials and revenue share.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Branch Avenue HQ",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro check && astro build",
    "build:fast": "astro build && npm run build:seed",
    "build:seed": "esbuild scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed.mjs --log-level=warning",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf .data && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@astrojs/node": "^11.1.14",
    "@astrojs/preact": "^6.1.6",
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "preact": "^11.2.0",
    "stripe": "^23.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
