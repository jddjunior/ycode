---
/** Teaching empty state: icon, benefit line, primary CTA and an optional "learn how" link. */
import Icon from '../Icon.astro';
interface Props { icon?: string; title: string; text: string; cta?: { href: string; label: string }; learn?: { href: string; label: string } }
const { icon = 'sparkle', title, text, cta, learn } = Astro.props;
---
<div class="px-6 py-10 text-center">
  <span class="mx-auto grid place-items-center size-14 rounded-2xl bg-brand-soft text-brand"><Icon name={icon} size={26} /></span>
  <p class="mt-3 font-[family-name:var(--font-display)] font-extrabold text-lg">{title}</p>
  <p class="mt-1 text-sm text-ink-2 max-w-md mx-auto">{text}</p>
  {(cta || learn) && (
    <div class="mt-4 flex flex-wrap justify-center gap-2">
      {cta && <a class="btn-primary" href={cta.href}>{cta.label}</a>}
      {learn && <a class="btn-ghost" href={learn.href}>{learn.label}</a>}
    </div>
  )}
</div>
