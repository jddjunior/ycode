---
/** Weather risk chip for an event day. `risk` null = no forecast available. */
import Icon from '../Icon.astro';
import type { WeatherRisk } from '../../lib/weather';
interface Props { risk: WeatherRisk | null | undefined; compact?: boolean }
const { risk, compact = false } = Astro.props;
const meta = !risk ? { cls: 'bg-canvas text-ink-2 border border-line', label: 'No forecast', icon: 'cloud' }
  : risk.level === 'stop' ? { cls: 'bg-red-100 text-red-800', label: 'STOP · high wind', icon: 'x' }
  : risk.level === 'watch' ? { cls: 'bg-amber-100 text-amber-900', label: 'Watch', icon: 'cloud' }
  : { cls: 'bg-green-100 text-green-800', label: 'Clear to bounce', icon: 'check' };
const detail = risk ? `${Math.round(risk.maxWindMph)} mph wind · gusts ${Math.round(risk.maxGustMph)} · ${risk.precipProb}% rain · ${Math.round(risk.maxTempF)}°F` : 'Forecasts appear up to 16 days out';
---
<span class:list={['chip whitespace-nowrap', meta.cls]} title={risk?.reasons.join('; ') || detail}>
  <Icon name={meta.icon} size={12} />{meta.label}{!compact && risk && <span class="font-normal opacity-80">· {Math.round(risk.maxWindMph)} mph</span>}
</span>
