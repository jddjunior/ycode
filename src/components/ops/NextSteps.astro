---
/**
 * Success state after a create / save / convert: what happened + the most
 * likely next actions. `celebrate` adds a CSS-only burst (respects reduced motion).
 */
import Icon from '../Icon.astro';
interface Action { href?: string; label: string; icon?: string; primary?: boolean; form?: Record<string, string> }
interface Props { title: string; text?: string; actions: Action[]; celebrate?: boolean; dismiss?: string }
const { title, text, actions, celebrate = false, dismiss } = Astro.props;
---
<section class:list={['ns-card relative overflow-hidden card p-5 mb-6 border-green-200 bg-gradient-to-br from-green-50 via-white to-white', celebrate && 'ns-celebrate']} aria-labelledby="ns-title" role="status">
  {celebrate && <div class="ns-burst" aria-hidden="true">{Array.from({ length: 14 }, (_, i) => <i style={`--i:${i}`}></i>)}</div>}
  <div class="flex items-start gap-3">
    <span class="ns-check grid place-items-center size-10 rounded-full bg-mint text-white shrink-0"><Icon name="check" size={20} /></span>
    <div class="min-w-0 flex-1">
      <h2 id="ns-title" class="font-bold text-lg">{title}</h2>
      {text && <p class="text-sm text-ink-2 mt-0.5">{text}</p>}
      <p class="text-xs font-semibold uppercase tracking-wide text-ink-2 mt-3">Next steps</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {actions.map((a) => a.form ? (
          <form method="post">{Object.entries(a.form).map(([k, v]) => <input type="hidden" name={k} value={v} />)}<button class={a.primary ? 'btn-primary' : 'btn-ghost'}>{a.icon && <Icon name={a.icon} size={16} />}{a.label}</button></form>
        ) : (
          <a href={a.href} class={a.primary ? 'btn-primary' : 'btn-ghost'}>{a.icon && <Icon name={a.icon} size={16} />}{a.label}</a>
        ))}
      </div>
    </div>
    {dismiss && <a href={dismiss} class="grid place-items-center size-9 rounded-lg text-ink-2 hover:bg-canvas shrink-0" aria-label="Dismiss"><Icon name="x" size={16} /></a>}
  </div>
</section>
<style is:global>
  .ns-check { animation: ns-pop .5s cubic-bezier(.2,1.6,.4,1) both; }
  @keyframes ns-pop { from { transform: scale(.4); opacity: 0 } to { transform: scale(1); opacity: 1 } }
  .ns-burst { position: absolute; left: 2.4rem; top: 2.4rem; pointer-events: none; }
  .ns-burst i { position: absolute; width: 8px; height: 8px; border-radius: 2px; opacity: 0;
    background: hsl(calc(var(--i) * 47) 85% 58%);
    animation: ns-fly 1.1s ease-out .15s forwards;
    --a: calc(var(--i) * 25.7deg); }
  @keyframes ns-fly {
    0% { transform: rotate(var(--a)) translateX(0) scale(1); opacity: 1 }
    100% { transform: rotate(var(--a)) translateX(90px) rotate(180deg) scale(.6); opacity: 0 }
  }
  @media (prefers-reduced-motion: reduce) { .ns-check, .ns-burst i { animation: none; } .ns-burst { display: none; } }
</style>
