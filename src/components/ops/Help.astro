---
/** Benefit line + collapsible "How it works / tips" panel for a feature. */
import Icon from '../Icon.astro';
interface Props { benefit: string; title?: string; open?: boolean }
const { benefit, title = 'How it works & tips', open = false } = Astro.props;
---
<div class="mb-5 rounded-2xl border border-brand/15 bg-gradient-to-r from-brand-soft/70 to-white">
  <details class="group" open={open}>
    <summary class="list-none cursor-pointer flex flex-wrap sm:flex-nowrap items-start sm:items-center gap-x-3 gap-y-1 px-4 py-3 rounded-2xl">
      <span class="grid place-items-center size-8 rounded-lg bg-white text-brand border border-brand/15 shrink-0"><Icon name="sparkle" size={16} /></span>
      <span class="text-sm text-ink flex-1 min-w-0 basis-[calc(100%-3rem)] sm:basis-auto"><span class="font-semibold">How this helps you:</span> {benefit}</span>
      <span class="text-xs font-semibold text-brand whitespace-nowrap inline-flex items-center gap-1 pl-11 sm:pl-0">{title}<Icon name="arrow" size={12} class="rotate-90 group-open:-rotate-90 transition-transform" /></span>
    </summary>
    <div class="px-4 pb-4 sm:pl-15 text-sm text-ink-2 prose-app [&_li]:text-sm [&_strong]:text-ink"><slot /></div>
  </details>
</div>
