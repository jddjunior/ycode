---
interface Props { crumbs: { name: string; href?: string }[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 s-sub font-semibold">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="opacity-50">›</span>}
        {c.href && i < crumbs.length - 1 ? <a href={c.href} class="hover:underline hover:text-ink">{c.name}</a> : <span aria-current="page" class="text-ink">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
