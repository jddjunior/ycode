---
import type { SiteCtx } from '../../../lib/site/data';
import { smsHref } from '../../../lib/site/data';
import Icon from '../../Icon.astro';
interface Props { ctx: SiteCtx; props: Record<string, unknown>; exclude?: string }
const { ctx, props: p, exclude } = Astro.props;
const cities = ctx.cities.filter((c) => c.slug !== exclude).slice(0, 24);
---
{cities.length > 0 && (
<section class="s-wrap s-section !pt-6">
  <div class="s-tile p-6 sm:p-10 grid lg:grid-cols-[.9fr_1.1fr] gap-8 items-center">
    <div>
      <h2 class="s-h2">{String(p.title ?? 'Areas we serve')}</h2>
      <p class="s-lede mt-3">Delivery fees are shown from your ZIP before checkout — no surprises.</p>
      {ctx.tenant.phone && <a href={smsHref(ctx.tenant.phone, 'Hi! Do you deliver to ZIP ')} class="mt-5 inline-flex items-center gap-2 font-extrabold min-h-11 hover:underline"><Icon name="message" size={18} /> Not listed? Text us your ZIP</a>}
    </div>
    <ul class="flex flex-wrap gap-2.5">
      {cities.map((c) => (
        <li><a href={ctx.href(`/areas/${c.slug}`)} class="s-filter hover:border-[var(--c-ink)]"><Icon name="map" size={16} class="mr-1.5 text-primary" />{c.local?.city ?? c.title}</a></li>
      ))}
    </ul>
  </div>
</section>
)}
