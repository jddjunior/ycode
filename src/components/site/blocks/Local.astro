---
/** City-page local facts: neighborhoods, parks/venues, delivery, rules and season — keeps each city page genuinely unique. */
import type { SiteCtx } from '../../../lib/site/data';
import type { LocalFacts } from '../../../db/schema';
import { deliveryZones, telHref } from '../../../lib/site/data';
import { haversineMiles } from '../../../lib/geo';
import { money } from '../../../lib/pricing';
import Icon from '../../Icon.astro';
interface Props { ctx: SiteCtx; local?: LocalFacts | null }
const { ctx, local } = Astro.props;
const t = ctx.tenant;
const city = local?.city ?? t.city;
const zones = await deliveryZones(t.id);
const zips = local?.zips ?? [];
const zoneHits = zones.filter((z) => z.zips.some((zz) => zips.includes(zz)));
const fees = zoneHits.length ? zoneHits.map((z) => z.feeCents) : [];
const feeLine = fees.length
  ? (Math.max(...fees) === 0 ? `Free delivery, setup and pickup anywhere in ${city}.` : `Delivery to ${city} is ${money(Math.min(...fees))}${Math.max(...fees) !== Math.min(...fees) ? `–${money(Math.max(...fees))}` : ''} depending on ZIP, including setup and pickup.`)
  : `Enter your ${city} ZIP at checkout to see the exact delivery fee before you pay — setup and pickup are always included.`;
const miles = local?.lat != null && local?.lng != null && t.lat != null && t.lng != null ? haversineMiles({ lat: t.lat, lng: t.lng }, { lat: local.lat, lng: local.lng }) : null;
const hasWet = ctx.items.some((i) => i.isWet);
const generator = ctx.items.find((i) => /generator/i.test(i.name));
const intro = local?.intro ?? `We deliver bounce houses, combos, water slides and party extras across ${city}${local?.neighborhoods?.length ? ` — from ${local.neighborhoods.slice(0, 3).join(', ')} to ${local.neighborhoods.at(-1)}` : ''}. Same crew, same spotless equipment, same easy online booking.`;
---
<section class="s-wrap s-section">
  <div class="grid lg:grid-cols-[1.15fr_.85fr] gap-8 lg:gap-12 items-start">
    <div>
      <p class="s-eyebrow">Local to {city}</p>
      <h2 class="s-h2 mt-3">Party rentals delivered across {city}</h2>
      <p class="s-lede mt-4">{intro}</p>
      {local?.neighborhoods?.length ? (
        <div class="mt-7">
          <h3 class="s-h3">Neighborhoods we visit every week</h3>
          <ul class="mt-3 flex flex-wrap gap-2">{local.neighborhoods.map((n) => <li class="s-chip">{n}</li>)}</ul>
        </div>
      ) : null}
      {(local?.parks?.length || local?.venues?.length) ? (
        <div class="mt-7 grid sm:grid-cols-2 gap-4">
          {local?.parks?.length ? (
            <div class="s-tile p-5">
              <h3 class="s-h3 flex items-center gap-2"><Icon name="map" size={18} /> Parks we set up at</h3>
              <ul class="mt-3 grid gap-1.5 text-sm font-semibold">{local.parks.map((p) => <li>{p}</li>)}</ul>
              <p class="mt-3 text-xs s-sub">Most public parks need a reservation or permit, and power usually means a generator{generator ? ` (${money(generator.priceCents)} add-on)` : ''}. We’ll send a certificate of insurance for your permit.</p>
            </div>
          ) : null}
          {local?.venues?.length ? (
            <div class="s-tile p-5">
              <h3 class="s-h3">Popular venues</h3>
              <ul class="mt-3 grid gap-1.5 text-sm font-semibold">{local.venues.map((v) => <li>{v}</li>)}</ul>
            </div>
          ) : null}
        </div>
      ) : null}
    </div>
    <aside class="s-card p-6 grid gap-5">
      <div class="flex gap-3">
        <span class="grid place-items-center size-11 shrink-0 rounded-xl bg-primary text-primary-ink"><Icon name="truck" size={20} /></span>
        <div><p class="font-extrabold">Delivery to {city}</p><p class="text-sm s-sub mt-0.5">{feeLine}{local?.deliveryNote ? ` ${local.deliveryNote}` : ''}</p></div>
      </div>
      <div class="flex gap-3">
        <span class="grid place-items-center size-11 shrink-0 rounded-xl bg-primary text-primary-ink"><Icon name="clock" size={20} /></span>
        <div><p class="font-extrabold">Arrival window</p><p class="text-sm s-sub mt-0.5">Setup happens 1–3 hours before your start time{miles != null ? ` — ${city} is about ${Math.round(miles)} miles from our warehouse` : ''}. We text you an arrival window the day before.</p></div>
      </div>
      <div class="flex gap-3">
        <span class="grid place-items-center size-11 shrink-0 rounded-xl bg-primary text-primary-ink"><Icon name="cloud" size={20} /></span>
        <div><p class="font-extrabold">Weather-safe in {city}</p><p class="text-sm s-sub mt-0.5">We watch the wind forecast for your exact date. Above {t.settings?.windLimitMph ?? 15} mph we reschedule free or give a 12-month credit.</p></div>
      </div>
      {hasWet && (
        <div class="flex gap-3">
          <span class="grid place-items-center size-11 shrink-0 rounded-xl bg-primary text-primary-ink"><Icon name="sparkle" size={20} /></span>
          <div><p class="font-extrabold">Water slide season</p><p class="text-sm s-sub mt-0.5">Summer weekends in {city} fill first — book slides a few weeks ahead and have a hose within 50 ft.</p></div>
        </div>
      )}
      {t.phone && <a href={telHref(t.phone)} class="s-btn s-btn-ghost w-full">Questions about {city}? {t.phone}</a>}
    </aside>
  </div>
</section>
