---
import type { SiteCtx } from '../../../lib/site/data';
import { telHref, smsHref, bookableDays } from '../../../lib/site/data';
import Icon from '../../Icon.astro';
interface Props { ctx: SiteCtx; props: Record<string, unknown> }
const { ctx, props: p } = Astro.props;
const t = ctx.tenant;
const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
const returnPath = ctx.href(Astro.url.pathname.replace(new RegExp(`^/sites/${t.slug}`), '') || '/');
const { minDay } = bookableDays(t);
---
<section class="s-wrap s-section" id="contact">
  <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-8 lg:gap-12 items-start">
    <div class="s-card p-5 sm:p-8">
      <h2 class="s-h2 !text-3xl">{String(p.title ?? 'Get a quote')}</h2>
      {p.text && <p class="s-sub mt-2">{String(p.text)}</p>}
      {sent ? (
        <div role="status" class="mt-6 rounded-2xl bg-soft p-5">
          <p class="font-display text-xl font-bold">Thanks — we got it! 🎉</p>
          <p class="mt-1 s-sub">A real person will reply by text or email — usually within the hour during the day, and first thing next morning for late-night requests.</p>
          <p class="mt-3 font-bold">Need an answer right now?</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {t.phone && <a href={smsHref(t.phone)} class="s-btn s-btn-primary s-btn-sm"><Icon name="message" size={16} /> Text us</a>}
            {t.phone && <a href={telHref(t.phone)} class="s-btn s-btn-ghost s-btn-sm"><Icon name="phone" size={16} /> Call {t.phone}</a>}
            <a href={ctx.href('/rentals#check')} class="s-btn s-btn-cta s-btn-sm">Check a date & book online</a>
          </div>
        </div>
      ) : (
        <form method="post" action={`${ctx.api}/lead`} class="mt-6 grid sm:grid-cols-2 gap-4" oninput="this.email.setCustomValidity('')" onsubmit="var e=this.email,p=this.phone;if(!e.value.trim()&&p.value.replace(/\D/g,'').length<7){e.setCustomValidity('Add an email or a phone number so we can reply');e.reportValidity();return false}var b=this.querySelector('[type=submit]');b.setAttribute('aria-disabled','true');b.textContent='Sending…'">
          {error && <p role="alert" class="sm:col-span-2 s-err">{error}</p>}
          <input type="hidden" name="return" value={returnPath} />
          <input type="hidden" name="source" value="quote_form" />
          <div class="hidden" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="sm:col-span-2"><label class="s-label" for="ct-name">Name</label><input id="ct-name" name="name" class="s-input" autocomplete="name" required maxlength="120" /></div>
          <div><label class="s-label" for="ct-email">Email</label><input id="ct-email" name="email" type="email" class="s-input" autocomplete="email" /></div>
          <div><label class="s-label" for="ct-phone">Mobile</label><input id="ct-phone" name="phone" type="tel" class="s-input" autocomplete="tel" /></div>
          <div><label class="s-label" for="ct-date">Event date <span class="font-normal s-sub">(optional)</span></label><input id="ct-date" name="eventDate" type="date" min={minDay} class="s-input" /></div>
          <div><label class="s-label" for="ct-zip">Event ZIP</label><input id="ct-zip" name="zip" inputmode="numeric" maxlength="5" pattern="\d{5}" class="s-input" autocomplete="postal-code" /></div>
          <div class="sm:col-span-2"><label class="s-label" for="ct-msg">What are you planning?</label><textarea id="ct-msg" name="message" class="s-input" rows="4" maxlength="4000" placeholder="Guest count, ages, venue, what you’re thinking of renting…"></textarea></div>
          <p class="sm:col-span-2 s-hint -mt-1">Add an email or phone so we can reply.</p>
          <button class="sm:col-span-2 s-btn s-btn-primary s-btn-lg" type="submit">Send my request</button>
        </form>
      )}
    </div>
    <aside class="grid gap-4">
      <div class="s-tile p-6">
        <p class="font-display text-xl font-bold">Fastest answer? Text us.</p>
        <p class="s-sub mt-1">Send your date and ZIP — we’ll confirm availability and the delivery fee.</p>
        {t.phone && <div class="mt-4 grid grid-cols-2 gap-2">
          <a href={smsHref(t.phone)} class="s-btn s-btn-primary"><Icon name="message" size={18} /> Text</a>
          <a href={telHref(t.phone)} class="s-btn s-btn-ghost"><Icon name="phone" size={18} /> Call</a>
        </div>}
      </div>
      <address class="s-tile p-6 not-italic grid gap-1 text-sm">
        <span class="font-display text-lg font-bold">{t.name}</span>
        {t.addressLine && <span>{t.addressLine}</span>}
        <span>{t.city}, {t.state} {t.zip}</span>
        {t.phone && <a class="font-bold hover:underline" href={telHref(t.phone)}>{t.phone}</a>}
        {t.email && <a class="hover:underline break-all" href={`mailto:${t.email}`}>{t.email}</a>}
      </address>
      <div class="s-tile p-6 text-sm">
        <p class="font-bold">Schools, churches & companies</p>
        <p class="s-sub mt-1">We provide a certificate of insurance (COI), W-9 and invoices for purchase orders.</p>
      </div>
    </aside>
  </div>
</section>
