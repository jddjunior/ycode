---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import Icon from '../components/Icon.astro';
import HeroScene from '../components/marketing/HeroScene.astro';
import { PLANS, planList, MARKETPLACE_FEE_BPS } from '../lib/plans';
import { platformUrl } from '../lib/tenant';
import { money } from '../lib/pricing';

const pct = (b: number) => `${Number((b / 100).toFixed(2))}%`;
const plans = planList();
const faqs = [
  { q: 'Do I own my website and domain?', a: 'Yes. Connect your own domain on day one, export your pages and content any time, and leave whenever you want. No hostage websites.' },
  { q: 'Will I lose my Google rankings if I switch?', a: 'Not if the move is mapped properly. We import your old URLs, set up permanent 301 redirects to the matching new pages, keep your titles and structured data, and time the switch for your slow season. Assisted migration is free on every plan.' },
  { q: 'Is pricing really not per item?', a: `Correct. Every plan includes unlimited inventory and you never pay more because you bought another bounce house. You pay a flat monthly price plus a small platform fee on online payments (${pct(PLANS.elite.platformFeeBps)}–${pct(PLANS.starter.platformFeeBps)}). You can pass that fee to customers if you prefer.` },
  { q: 'What does the marketplace cost?', a: `Listing is free. A ${pct(MARKETPLACE_FEE_BPS)} fee applies only to bookings the BounceOS marketplace sends you. Bookings from your own website, ads, socials and repeat customers carry no marketplace fee.` },
  { q: 'Do I need a separate marketing tool like HighLevel?', a: 'No. Email and SMS campaigns, birthday re-book automations, review requests, a social scheduler and a Google & Meta ad builder are built in.' },
  { q: 'How long does setup take?', a: 'Most operators are live the same day: create your account, add your rentals (or let us import them), and your SEO website with city pages is published automatically.' },
  { q: 'What happens in bad weather?', a: 'Every booking checks the forecast against your wind limit, flags risky days, and lets you reschedule or issue a credit in a couple of clicks.' },
];
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'BounceOS', applicationCategory: 'BusinessApplication', operatingSystem: 'Web, iOS, Android',
    description: 'The all-in-one operating system for bounce house and party rental businesses: online booking, deliveries, SEO website, marketing, social, ads and a partner network.',
    url: platformUrl() + '/', publisher: { '@type': 'Organization', name: 'Branch Avenue HQ' },
    offers: plans.map((p) => ({ '@type': 'Offer', name: `BounceOS ${p.name}`, price: (p.monthlyCents / 100).toFixed(2), priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: (p.monthlyCents / 100).toFixed(2), priceCurrency: 'USD', unitCode: 'MON' } })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const pillars = [
  { key: 'Run', color: 'bg-brand', blurb: 'The calm, organized weekend.', items: [
    { icon: 'calendar', t: 'Live availability booking', d: 'Customers pick a date, see what’s really free, pay a deposit and e-sign — 24/7.' },
    { icon: 'truck', t: 'Routes & crew app', d: 'Optimized delivery routes with setup times, plus a crew app with checklists for every stop.' },
    { icon: 'cloud', t: 'Weather guard', d: 'Wind and rain forecasts on every booking, with one-click reschedule or credit.' },
    { icon: 'box', t: 'Unlimited inventory', d: 'Units, add-ons and packages with cleaning buffers — never priced per item.' },
  ] },
  { key: 'Grow', color: 'bg-pop', blurb: 'Marketing that’s built in, not bolted on.', items: [
    { icon: 'globe', t: 'SEO website you own', d: 'Fast storefront, product schema, and a page for every town you serve.' },
    { icon: 'megaphone', t: 'Campaigns & reviews', d: 'Birthday re-books, review requests and promos by email and SMS.' },
    { icon: 'share', t: 'Social studio', d: 'AI captions from your rentals, scheduled to Facebook, Instagram and Google.' },
    { icon: 'target', t: 'Ads with cost per booking', d: 'Search campaigns per city, exported or managed — measured in bookings, not clicks.' },
  ] },
  { key: 'Earn', color: 'bg-mint', blurb: 'Get paid for being part of the network.', items: [
    { icon: 'gift', t: 'Referral commissions', d: `${pct(PLANS.pro.referralCommissionBps)} of every operator you refer, for 12 months.` },
    { icon: 'users', t: 'Overflow partners', d: 'Sold out Saturday? Send the lead to a partner and earn a share when they book.' },
    { icon: 'map', t: 'Marketplace leads', d: 'Families searching your ZIP on BounceOS find you — fee only when they book.' },
    { icon: 'dollar', t: 'A ledger you can audit', d: 'Every commission, share and payout status in one place — no mystery deductions.' },
  ] },
];
const rentalTypes = ['Bounce houses', 'Water slides', 'Combo bouncers', 'Obstacle courses', 'Interactive games', 'Concessions', 'Tents, tables & chairs'];
const inflatable = [
  { icon: 'cloud', t: 'Wind limit on every booking', d: 'Set your limit (15 mph by default). Each event day is checked against the forecast and flagged Clear, Watch or Stop.' },
  { icon: 'shield', t: 'Grass, concrete or gym floor', d: 'Customers pick the setup surface at checkout. Sandbag and indoor fees are added automatically.' },
  { icon: 'bolt', t: 'Blowers, outlets and generators', d: 'Every unit lists the outlets it needs. No power within 50 ft? The generator add-on is offered right in the cart.' },
  { icon: 'sparkle', t: 'Wet or dry, and when', d: 'Mark slides wet, dry or both. Shoppers filter by it, and the prep checklist reminds them about the hose.' },
  { icon: 'clock', t: 'Setup and teardown buffers', d: 'A castle that ends at 5 isn’t free at 5. Buffers per unit keep back-to-back bookings honest.' },
  { icon: 'map', t: 'Parks, schools and churches', d: 'City pages cover permits and generator rules, and your certificate-of-insurance promise is built into the site.' },
  { icon: 'wrench', t: 'Cleaning and repair logs', d: 'Crew log cleaning from their phone. A unit out for a patch comes off the calendar until it’s back.' },
  { icon: 'check', t: 'Safety rules, signed', d: 'Your rental agreement and safety rules are e-signed at checkout, with name, time and IP on file.' },
];
const themes = [
  { key: 'carnival', name: 'Backyard Carnival' }, { key: 'splash', name: 'Splash Pop' },
  { key: 'mono', name: 'Modern Mono Party' }, { key: 'arcade', name: 'Arcade' },
];
---
<PlatformLayout title="BounceOS — Bounce House Rental Software That Gets You Booked | Branch Avenue HQ" description="Bounce house rental software: online booking, deliveries, crew app, an SEO website, email & SMS, social, Google Ads and a partner network. Flat pricing, unlimited inflatables, you own your site." ld={ld}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="lp">
    <!-- Hero: a backyard on party day -->
    <section class="lp-hero">
      <div class="max-w-6xl mx-auto px-4 pt-10 sm:pt-16 grid gap-10 lg:grid-cols-[1fr_1.05fr] items-center">
        <div class="relative z-10">
          <p class="lp-eyebrow"><span aria-hidden="true">🎈</span> Bounce house &amp; party rental software</p>
          <h1 class="lp-h1 mt-4">Fill every weekend.<br /><span class="lp-mark">Skip the chaos.</span></h1>
          <p class="mt-5 text-lg sm:text-xl text-[#2A3160] max-w-xl">BounceOS takes the booking, checks the wind, routes the truck and brings last year’s birthday parents back — with a website that ranks in every town you deliver to.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/signup" class="lp-cta">Start your free 30-day trial <Icon name="arrow" size={18} /></a>
            <a href="/sites/bounce-brigade/" class="lp-ghost">See a live rental site</a>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[#1B1F4A]">
            <li class="flex items-center gap-1.5"><Icon name="check" size={16} class="text-[#15803D]" />Unlimited inflatables, one flat price</li>
            <li class="flex items-center gap-1.5"><Icon name="check" size={16} class="text-[#15803D]" />You own your website</li>
            <li class="flex items-center gap-1.5"><Icon name="check" size={16} class="text-[#15803D]" />No card to start</li>
          </ul>
        </div>
        <div class="relative">
          <HeroScene class="lp-scene" />
          <div class="lp-toast lp-toast-1">
            <span class="lp-toast-ico bg-[#DCFCE7] text-[#15803D]"><Icon name="check" size={16} /></span>
            <span><strong>New booking · Rainbow Castle</strong><br /><span class="text-[#4A4866]">Sat 11 AM · $51 deposit paid</span></span>
          </div>
          <div class="lp-toast lp-toast-2">
            <span class="lp-toast-ico bg-[#FEF3C7] text-[#92400E]"><Icon name="cloud" size={16} /></span>
            <span><strong>Wind watch · Sunday</strong><br /><span class="text-[#4A4866]">Gusts 19 mph · 2 events flagged</span></span>
          </div>
          <div class="lp-toast lp-toast-3">
            <span class="lp-toast-ico bg-[#E0E7FF] text-[#3730A3]"><Icon name="truck" size={16} /></span>
            <span><strong>Saturday route ready</strong><br /><span class="text-[#4A4866]">6 drop-offs · 41 miles</span></span>
          </div>
        </div>
      </div>
      <svg class="lp-grass" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50 Q180 0 360 38 T720 34 T1080 40 T1440 26 V90 H0Z" fill="#4BB35C" /><path d="M0 70 Q240 36 480 62 T960 58 T1440 60 V90 H0Z" fill="#3FA552" /></svg>
    </section>

    <!-- What you rent -->
    <section class="bg-[#3FA552] text-white">
      <div class="max-w-6xl mx-auto px-4 pb-7 pt-1 flex flex-wrap items-center gap-x-3 gap-y-2">
        <p class="font-bold mr-1">Built for everything on your trailer:</p>
        {rentalTypes.map((r) => <span class="rounded-full bg-white/18 ring-1 ring-white/30 px-3 py-1 text-sm font-semibold">{r}</span>)}
      </div>
    </section>

    <!-- What your customers see -->
    <section class="bg-[#FFFBF2]">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
        <p class="lp-kicker text-[#C2410C]">What parents see</p>
        <h2 class="lp-h2 mt-2 max-w-3xl">A rental site that answers the only question that matters: “Is it open on my date?”</h2>
        <p class="mt-3 text-lg text-[#4A4866] max-w-2xl">Date and ZIP first. Real availability, the delivery fee up front, a small deposit, and a signed agreement — on your domain, in your colors.</p>
        <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_260px] items-end">
          <div>
            <div class="lp-browser">
              <div class="lp-browser-bar"><i></i><i></i><i></i><span>yourcompany.com</span></div>
              {themes.map((t, i) => <img src={`/marketing/store-${t.key}.jpg`} alt={`Example operator storefront in the ${t.name} theme with a date and ZIP availability search`} width="1920" height="1200" loading="lazy" decoding="async" class:list={['lp-theme-img', i === 0 && 'is-on']} data-theme={t.key} />)}
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Preview a theme">
              <span class="text-sm font-semibold text-[#4A4866] mr-1">Four looks, one click:</span>
              {themes.map((t, i) => <button type="button" class="lp-theme-btn" aria-pressed={i === 0 ? 'true' : 'false'} data-theme-btn={t.key}>{t.name}</button>)}
            </div>
          </div>
          <figure class="lp-phone mx-auto">
            <img src="/marketing/product-phone.jpg" alt="Water slide product page on a phone with price, date check and reserve button" width="780" height="1688" loading="lazy" decoding="async" />
            <figcaption class="sr-only">Product page on a phone</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Built for inflatables -->
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
        <p class="lp-kicker text-[#1D4ED8]">Not generic rental software</p>
        <h2 class="lp-h2 mt-2 max-w-3xl">It knows a bounce house isn’t a folding chair.</h2>
        <p class="mt-3 text-lg text-[#4A4866] max-w-2xl">Tool-rental and tent software treats an 18-foot water slide like any other line item. BounceOS is built around how inflatables actually go out the door.</p>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {inflatable.map((f, i) => (
            <li class="lp-card">
              <span class:list={['lp-card-ico', ['bg-[#DBEAFE] text-[#1D4ED8]', 'bg-[#FFEDD5] text-[#C2410C]', 'bg-[#FEF9C3] text-[#854D0E]', 'bg-[#DCFCE7] text-[#15803D]'][i % 4]]}><Icon name={f.icon} size={20} /></span>
              <h3 class="mt-3 font-bold text-[#1B1F4A]">{f.t}</h3>
              <p class="mt-1 text-sm text-[#4A4866] leading-relaxed">{f.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Run: the operator side, shown -->
    <section id="features" class="bg-[#EAF6FF]">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
        <p class="lp-kicker text-[#1D4ED8]">Party day, handled</p>
        <h2 class="lp-h2 mt-2 max-w-3xl">Saturday morning, one screen tells you everything.</h2>
        <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_250px] items-center">
          <div class="lp-browser">
            <div class="lp-browser-bar"><i></i><i></i><i></i><span>BounceOS · Game Plan</span></div>
            <img src="/marketing/app-gameplan.jpg" alt="BounceOS Game Plan dashboard showing bookings, revenue, today’s drop-offs with weather, the monthly goal and a party streak" width="2160" height="1350" loading="lazy" decoding="async" />
          </div>
          <figure class="lp-phone mx-auto">
            <img src="/marketing/app-crew-phone.jpg" alt="Crew app on a phone with the day’s stops, wind limit, navigation and a setup checklist" width="780" height="1688" loading="lazy" decoding="async" />
            <figcaption class="mt-3 text-center text-sm font-semibold text-[#1B1F4A]">The crew app: stops in order, anchor checklist, one-tap navigate.</figcaption>
          </figure>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {pillars.map((p, i) => (
            <div class="lp-pillar">
              <div class="flex items-center gap-3">
                <span class:list={['grid place-items-center size-10 rounded-2xl font-black text-lg', ['bg-[#2563EB] text-white', 'bg-[#FF5A1F] text-[#1B1F4A]', 'bg-[#16A34A] text-white'][i]]}>{p.key[0]}</span>
                <div><h3 class="lp-h3">{p.key}</h3><p class="text-sm text-[#4A4866]">{p.blurb}</p></div>
              </div>
              <ul class="mt-5 space-y-4">
                {p.items.map((it) => (
                  <li class="flex gap-3">
                    <Icon name={it.icon} size={18} class="mt-0.5 shrink-0 text-[#1B1F4A]" />
                    <span><span class="block font-semibold text-[#1B1F4A]">{it.t}</span><span class="block text-sm text-[#4A4866] leading-relaxed">{it.d}</span></span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- The problem with what you use now -->
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20 grid gap-10 lg:grid-cols-2 items-center">
        <div>
          <p class="lp-kicker text-[#C2410C]">Sound familiar?</p>
          <h2 class="lp-h2 mt-2">You bought another slide, and your software bill went up.</h2>
          <p class="mt-4 text-lg text-[#4A4866]">Most operators stitch together booking software, a separate marketing system, an SEO agency and an answering service. Prices climb with every unit, and the website you paid for can’t come with you when you leave.</p>
          <a href="/compare" class="mt-5 inline-flex items-center gap-1.5 font-bold text-[#1D4ED8] hover:underline underline-offset-4">See the full comparison <Icon name="arrow" size={16} /></a>
        </div>
        <ul class="space-y-3">
          {[
            ['Priced per item', 'Some incumbents charge more as inventory grows — e.g. +$25 per 50 items on top tiers.'],
            ['Marketing is a second bill', 'Texts, email and review requests sold as a separate subscription ($97–$497/mo for HighLevel).'],
            ['SEO as an expensive add-on', 'Packages like $2,400 up front or $400/mo for six months, then more “to maintain rankings”.'],
            ['A website you can’t take with you', '“If you decide to leave, you can’t take it with you” — a real reviewer on a big incumbent.'],
          ].map(([t, d]) => (
            <li class="lp-card flex gap-3"><span class="grid place-items-center size-9 shrink-0 rounded-xl bg-[#FEE2E2] text-[#B91C1C]"><Icon name="x" size={18} /></span><span><span class="block font-bold text-[#1B1F4A]">{t}</span><span class="block text-sm text-[#4A4866]">{d}</span></span></li>
          ))}
          <li class="text-xs text-[#4A4866] pl-1">Figures from public vendor pages and reviews, as of 2026.</li>
        </ul>
      </div>
    </section>

    <!-- Setup -->
    <section class="bg-[#FFFBF2]">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
        <h2 class="lp-h2 text-center">Inflated and taking bookings this afternoon.</h2>
        <p class="mt-2 text-center text-lg text-[#4A4866]">Three steps. No “30 business days”.</p>
        <ol class="mt-10 grid gap-5 md:grid-cols-3">
          {[
            ['Tell us about your business', 'Pick a look and the towns you serve. Your booking website and a page for every city publish instantly.'],
            ['Add your inflatables', 'Photos, sizes, prices and setup needs — or send your spreadsheet or old site and we’ll import it.'],
            ['Turn on growth', 'Switch on review requests and birthday re-books, schedule a week of posts, and launch a Search campaign.'],
          ].map(([t, d], i) => (
            <li class="lp-card relative pt-8">
              <span class="lp-step">{i + 1}</span>
              <h3 class="font-bold text-lg text-[#1B1F4A]">{t}</h3>
              <p class="mt-1.5 text-sm text-[#4A4866] leading-relaxed">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Migration -->
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-4 py-6 sm:py-10">
        <div class="lp-switch">
          <div>
            <p class="lp-kicker text-[#FFD43B]">Switching software?</p>
            <h2 class="lp-h2 mt-2 !text-white">Move without losing your Google rankings.</h2>
            <p class="mt-3 text-white/85 max-w-lg">Fear of losing traffic keeps operators stuck on software they’ve outgrown. Every old URL gets a permanent redirect to its new home, your titles and structured data carry over, and you schedule the move for your off-season.</p>
            <a href="/signup" class="lp-cta mt-6">Plan my move <Icon name="arrow" size={18} /></a>
          </div>
          <ul class="space-y-2.5">
            {['Import from InflatableOffice, Event Rental Systems, WordPress or a spreadsheet', 'URL-by-URL 301 redirect map from your old sitemap', 'Your domain, your content, full export any time', 'Before/after Search Console check-in'].map((x) => (
              <li class="flex gap-2.5 rounded-2xl bg-white/12 ring-1 ring-white/20 px-4 py-3 text-sm font-medium text-white"><Icon name="check" size={18} class="shrink-0 text-[#FFD43B]" />{x}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-4 py-16 sm:py-20">
        <div class="flex flex-wrap items-end gap-4">
          <div>
            <h2 class="lp-h2">Buy another bounce house. Your bill doesn’t move.</h2>
            <p class="mt-2 text-lg text-[#4A4866]">Flat monthly pricing with unlimited rentals on every plan.</p>
          </div>
          <a href="/pricing" class="lp-ghost ml-auto">Compare plans &amp; fees</a>
        </div>
        <div class="mt-9 grid gap-5 md:grid-cols-3">
          {plans.map((p) => (
            <div class:list={['lp-card flex flex-col', p.id === 'pro' && 'lp-card-pop']}>
              {p.id === 'pro' && <span class="lp-badge">Most popular</span>}
              <h3 class="lp-h3">{p.name}</h3>
              <p class="mt-1"><span class="text-4xl font-bold text-[#1B1F4A] tabular-nums lp-num">{money(p.monthlyCents)}</span><span class="text-[#4A4866]">/mo</span></p>
              <p class="text-sm text-[#4A4866]">+ {pct(p.platformFeeBps)} on online payments</p>
              <ul class="mt-4 space-y-2 text-sm text-[#2A3160] flex-1">
                {p.features.slice(0, 6).map((f) => <li class="flex gap-2"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#15803D]" />{f}</li>)}
              </ul>
              <a href={`/signup?plan=${p.id}`} class:list={['mt-5 w-full', p.id === 'pro' ? 'lp-cta justify-center' : 'lp-ghost justify-center']}>Start with {p.name}</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-[#FFFBF2]">
      <div class="max-w-3xl mx-auto px-4 py-16 sm:py-20">
        <h2 class="lp-h2 text-center">Questions operators ask</h2>
        <div class="mt-8 space-y-3">
          {faqs.map((f) => (
            <details class="lp-faq">
              <summary>{f.q}<Icon name="plus" size={18} class="lp-faq-ico" /></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA: back in the yard -->
    <section class="lp-final">
      <div class="max-w-4xl mx-auto px-4 pt-16 pb-28 text-center relative z-10">
        <h2 class="lp-h1 !text-[2.4rem] sm:!text-6xl">Make this the summer you stop turning parties away.</h2>
        <p class="mt-4 text-lg text-[#2A3160]">30-day free trial. No card to start. Month to month.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/signup" class="lp-cta">Start free <Icon name="arrow" size={18} /></a>
          <a href="/find" class="lp-ghost">Looking to rent? Find a company</a>
        </div>
      </div>
      <svg class="lp-grass" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50 Q180 0 360 38 T720 34 T1080 40 T1440 26 V90 H0Z" fill="#4BB35C" /><path d="M0 70 Q240 36 480 62 T960 58 T1440 60 V90 H0Z" fill="#3FA552" /></svg>
    </section>
  </div>

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]');
    const imgs = document.querySelectorAll<HTMLImageElement>('.lp-theme-img');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      imgs.forEach((i) => i.classList.toggle('is-on', i.dataset.theme === b.dataset.themeBtn));
    }));
  </script>
</PlatformLayout>

<style>
  .lp { --lp-ink: #1B1F4A; --lp-display: 'Fredoka', 'Bricolage Grotesque', ui-rounded, system-ui, sans-serif; color: var(--lp-ink); }
  .lp :global(h1), .lp :global(h2), .lp :global(h3) { font-family: var(--lp-display); letter-spacing: -0.01em; }
  .lp-num { font-family: var(--lp-display); }
  .lp-hero { position: relative; overflow: hidden; background: linear-gradient(180deg, #9ADBFF 0%, #D9F1FF 62%, #F3FBFF 100%); padding-bottom: 5.5rem; }
  .lp-final { position: relative; overflow: hidden; background: linear-gradient(180deg, #D9F1FF 0%, #9ADBFF 100%); }
  .lp-grass { position: absolute; left: 0; right: 0; bottom: -1px; width: 100%; height: 70px; display: block; }
