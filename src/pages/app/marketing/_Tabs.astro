---
interface Props { active: 'campaigns' | 'reviews' }
const { active } = Astro.props;
const tabs = [{ key: 'campaigns', href: '/app/marketing', label: 'Campaigns & automations' }, { key: 'reviews', href: '/app/marketing/reviews', label: 'Reviews' }];
---
<nav class="flex gap-1 overflow-x-auto mb-5 -mx-1 px-1" aria-label="Marketing sections">
  {tabs.map((t) => (
    <a href={t.href} aria-current={active === t.key ? 'page' : undefined}
      class:list={['whitespace-nowrap rounded-full px-4 py-2 text-sm font-semibold border transition-colors', active === t.key ? 'bg-ink text-white border-ink' : 'bg-white border-line text-ink-2 hover:text-ink']}>{t.label}</a>
  ))}
</nav>
