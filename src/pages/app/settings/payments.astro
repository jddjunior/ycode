---
/** Settings → Payments: Stripe Connect onboarding (or a clear demo-mode explanation). */
import Shell from './_Shell.astro';
import Help from '../../../components/ops/Help.astro';
import Icon from '../../../components/Icon.astro';
import { formData, str, flash } from '../../../lib/forms';
import { connectOnboardingLink, stripeEnabled } from '../../../lib/payments';
import { PLANS } from '../../../lib/plans';
import { money } from '../../../lib/pricing';
import { opsCtx } from '../../../lib/ops/ctx';
import { updateTenant } from '../../../lib/ops/settings';
import { platformUrl } from '../../../lib/tenant';

const { t, canManage } = opsCtx(Astro);
const enabled = stripeEnabled();
const f = await formData(Astro);
if (f && canManage && str(f, '_action', 20) === 'connect') {
  if (!enabled) { flash(Astro.cookies, 'Stripe isn’t configured on this server yet — you’re in demo mode.', 'error'); return Astro.redirect('/app/settings/payments', 303); }
  try {
    const base = platformUrl();
    const link = await connectOnboardingLink(t, `${base}/app/settings/payments?connected=1`, `${base}/app/settings/payments?retry=1`);
    if (!link) throw new Error('no link');
    if (link.accountId !== t.stripeAccountId) await updateTenant(t.id, { stripeAccountId: link.accountId });
    return Astro.redirect(link.url, 303);
  } catch (e) {
    console.error(e);
    flash(Astro.cookies, 'Stripe didn’t respond — please try again in a minute.', 'error');
    return Astro.redirect('/app/settings/payments', 303);
  }
}
const plan = PLANS[t.plan] ?? PLANS.starter;
const state = t.stripeChargesEnabled ? 'live' : t.stripeAccountId ? 'pending' : 'none';
const q = Astro.url.searchParams;
const example = 30000, fee = Math.round((example * plan.platformFeeBps) / 10_000);
---
<Shell title="Payments" subtitle="Get paid online — deposits at checkout, balances before the party." active="payments">
  <Help benefit="Online deposits lock in dates instantly and cut no-shows; money lands in your bank on Stripe’s normal payout schedule.">
    <ul>
      <li>BounceOS uses <strong>Stripe Connect Express</strong>: you own the Stripe account, payouts go directly to you.</li>
      <li>Your {plan.name} plan’s platform fee is <strong>{(plan.platformFeeBps / 100).toFixed(2)}%</strong> of online payments (e.g. {money(fee)} on a {money(example)} booking), plus Stripe’s standard card fees. Cash and check payments are always free.</li>
      <li>Want customers to cover it? Turn on “pass the platform fee” in <a href="/app/settings/booking" class="text-brand font-semibold">Booking rules</a>.</li>
    </ul>
  </Help>
  {q.get('connected') && <p role="status" class="mb-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm px-4 py-3">Thanks! Stripe is verifying your details — charges switch on automatically once they’re approved.</p>}
  {q.get('retry') && <p role="status" class="mb-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm px-4 py-3">Your Stripe link expired. Click “Continue setup” to pick up where you left off.</p>}

  <section class="card p-6" aria-labelledby="stripe-h">
    <div class="flex flex-wrap items-start gap-4">
      <span class:list={['grid place-items-center size-14 rounded-2xl shrink-0', state === 'live' ? 'bg-green-100 text-green-700' : 'bg-brand-soft text-brand']}><Icon name={state === 'live' ? 'check' : 'dollar'} size={28} /></span>
      <div class="min-w-0 flex-1">
        <h2 id="stripe-h" class="font-bold text-xl">{state === 'live' ? 'Online payments are live' : state === 'pending' ? 'Finish connecting Stripe' : 'Connect Stripe to take deposits online'}</h2>
        <p class="text-sm text-ink-2 mt-1">{state === 'live' ? `Account ${t.stripeAccountId} · charges enabled. Deposits and balances go straight to your bank.` : state === 'pending' ? 'Stripe still needs a few details (bank account or ID verification) before charges are enabled.' : 'Takes about 5 minutes: business details, bank account and a quick identity check.'}</p>
        {enabled ? (
          canManage && state !== 'live' && (
            <form method="post" class="mt-4"><input type="hidden" name="_action" value="connect" /><button class="btn-primary" data-busy-label="Opening Stripe…"><Icon name="external" size={16} />{state === 'pending' ? 'Continue setup on Stripe' : 'Connect with Stripe'}</button></form>
          )
        ) : (
          <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950">
            <p class="font-bold flex items-center gap-2"><Icon name="bolt" size={16} />Demo mode</p>
            <p class="mt-1">Stripe isn’t configured on this BounceOS server (no <code class="font-mono text-xs">STRIPE_SECRET_KEY</code>), so checkout runs in demo mode: customers complete a simulated payment and bookings confirm exactly like real ones. Nothing is charged.</p>
            <p class="mt-2">Everything else works today — record cash and check payments on any booking, and the Connect button appears here as soon as the platform enables Stripe.</p>
          </div>
        )}
      </div>
    </div>
    <ol class="grid gap-3 sm:grid-cols-3 mt-6 text-sm">
      {[['Connect', 'Create or link your Stripe Express account.', state !== 'none'], ['Verify', 'Stripe checks your business & bank details.', state === 'live'], ['Get paid', 'Deposits at checkout; balances auto-charged before the event.', state === 'live']].map(([title, text, done], i) => (
        <li class:list={['rounded-xl border p-4', done ? 'border-green-200 bg-green-50' : 'border-line']}>
          <p class="font-bold flex items-center gap-2"><span class:list={['grid place-items-center size-6 rounded-full text-xs', done ? 'bg-mint text-white' : 'bg-canvas border border-line']}>{done ? <Icon name="check" size={12} /> : i + 1}</span>{title}</p>
          <p class="text-ink-2 mt-1">{text}</p>
        </li>
      ))}
    </ol>
  </section>
</Shell>
