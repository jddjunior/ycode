---
/** Customer detail: profile, tags, bookings and message history. */
import { and, desc, eq, or, sql } from 'drizzle-orm';
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
import StatusChip from '../../../components/ops/StatusChip.astro';
import Crumbs from '../../../components/ops/Crumbs.astro';
import SubmitGuard from '../../../components/ops/SubmitGuard.astro';
import { STAGE_META } from '../../../lib/ops/ctx';
import { getDb, schema } from '../../../db/client';
import { money } from '../../../lib/pricing';
import { send } from '../../../lib/notify';
import { formData, str, bool, list, flash } from '../../../lib/forms';
import { opsCtx, isUuid, CUSTOMER_TYPES, dateTime, dateOnly, isValidDay } from '../../../lib/ops/ctx';

const { t, tz, canManage } = opsCtx(Astro);
const id = Astro.params.id;
if (!isUuid(id)) return new Response('Not found', { status: 404 });
const db = await getDb();
const C = schema.customers;
const self = `/app/customers/${id}`;
const [c] = await db.select().from(C).where(and(eq(C.id, id), eq(C.tenantId, t.id))).limit(1);
if (!c) return new Response('Not found', { status: 404 });

const f = await formData(Astro);
if (f && canManage) {
  const action = str(f, '_action', 20);
  if (action === 'save') {
    const type = CUSTOMER_TYPES.find((x) => x === str(f, 'type', 20)) ?? c.type;
    const bday = str(f, 'celebrantBirthday', 10);
    await db.update(C).set({
      name: str(f, 'name', 120), phone: str(f, 'phone', 40), organization: str(f, 'organization', 120) || null, type,
      tags: [...new Set(list(f, 'tags').map((x) => x.replace(/^#/, '').toLowerCase().slice(0, 30)))].slice(0, 20),
      notes: str(f, 'notes', 4000), celebrantName: str(f, 'celebrantName', 80) || null, celebrantBirthday: isValidDay(bday) ? bday : null,
      marketingOptIn: bool(f, 'marketingOptIn'), smsOptIn: bool(f, 'smsOptIn'),
    }).where(and(eq(C.id, id), eq(C.tenantId, t.id)));
    flash(Astro.cookies, 'Customer saved.');
  } else if (action === 'message') {
    const channel = str(f, 'channel', 10) === 'sms' ? 'sms' : 'email';
    const body = str(f, 'body', 2000);
    const to = channel === 'sms' ? c.phone : c.email;
    if (!body || !to) flash(Astro.cookies, !body ? 'Write a message first.' : 'No phone number on file.', 'error');
    else {
      const m = await send({ tenantId: t.id, channel, to, subject: str(f, 'subject', 150) || `A note from ${t.name}`, body, customerId: c.id, fromName: t.name, replyTo: t.email || undefined });
      flash(Astro.cookies, m.status === 'failed' ? `Couldn’t send: ${m.error}` : `Message ${m.status === 'logged' ? 'logged (no provider configured)' : 'sent'}.`, m.status === 'failed' ? 'error' : 'ok');
    }
  }
  return Astro.redirect(self, 303);
}

const [bookings, msgs] = await Promise.all([
  db.select().from(schema.bookings).where(and(eq(schema.bookings.tenantId, t.id), eq(schema.bookings.customerId, id))).orderBy(desc(schema.bookings.startsAt)).limit(100),
  db.select().from(schema.messages).where(and(eq(schema.messages.tenantId, t.id), or(eq(schema.messages.customerId, id), eq(schema.messages.to, c.email)))).orderBy(desc(schema.messages.createdAt)).limit(50),
]);
const relatedLeads = c.email ? await db.select().from(schema.leads).where(and(eq(schema.leads.tenantId, t.id), sql`lower(${schema.leads.email}) = lower(${c.email})`)).limit(10) : [];
const live = bookings.filter((b) => ['pending', 'confirmed', 'completed'].includes(b.status));
const balance = live.reduce((s, b) => s + Math.max(0, b.totalCents - b.paidCents), 0);
const bookedTotal = live.reduce((s, b) => s + b.totalCents, 0);
---
<AppLayout title={c.name || c.email} section="customers" subtitle={`${c.organization ? c.organization + ' · ' : ''}Customer since ${dateOnly(c.createdAt, tz)} · source: ${c.source}`} wide>
  <Fragment slot="actions">
    <a href="/app/customers" class="btn-ghost"><Icon name="arrow" size={16} class="rotate-180" />All customers</a>
    {canManage && <a href={`/app/bookings/new?customerId=${c.id}`} class="btn-ghost"><Icon name="plus" size={16} />Book again</a>}
  </Fragment>
  <Crumbs slot="crumbs" items={[{ label: 'Customers', href: '/app/customers' }, { label: c.name || c.email }]} />

  <section class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6" aria-label="Customer numbers">
    <div class="kpi"><p class="kpi-label">Lifetime value</p><p class="kpi-value">{money(c.lifetimeValueCents)}</p></div>
    <div class="kpi"><p class="kpi-label">Bookings</p><p class="kpi-value">{live.length}</p></div>
    <div class="kpi"><p class="kpi-label">Booked total</p><p class="kpi-value">{money(bookedTotal)}</p></div>
    <div class="kpi"><p class="kpi-label">Balance due</p><p class:list={['kpi-value', balance && 'text-warn']}>{money(balance)}</p></div>
  </section>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
    <div class="space-y-6 min-w-0">
      <section class="card overflow-hidden" aria-labelledby="bk-h">
        <header class="px-5 py-4 border-b border-line"><h2 id="bk-h" class="font-bold text-lg">Bookings</h2></header>
        {bookings.length === 0 ? <p class="px-5 py-6 text-sm text-ink-2">No bookings yet. <a href={`/app/bookings/new?customerId=${c.id}`} class="text-brand font-semibold">Create their first booking</a></p> : (
          <ul class="divide-y divide-line">
            {bookings.map((b) => (
              <li><a href={`/app/bookings/${b.id}`} class="flex flex-wrap items-center gap-3 px-5 py-3 hover:bg-canvas">
                <span class="font-bold text-brand">#{b.number}</span>
                <span class="text-sm">{dateTime(b.startsAt, tz)}</span>
                <StatusChip status={b.status} />
                <span class="ml-auto text-sm font-semibold tabular-nums">{money(b.totalCents)}</span>
                {b.totalCents > b.paidCents && b.status !== 'canceled' && <span class="text-xs font-semibold text-warn">{money(b.totalCents - b.paidCents)} due</span>}
              </a></li>
            ))}
          </ul>
        )}
      </section>

      {relatedLeads.length > 0 && (
        <section class="card p-5" aria-labelledby="ld-h">
          <h2 id="ld-h" class="font-bold text-lg">Leads from this customer</h2>
          <ul class="mt-2 divide-y divide-line">
            {relatedLeads.map((l) => <li class="py-2 flex flex-wrap items-center gap-2 text-sm"><span class:list={['chip', STAGE_META[l.stage].cls]}>{STAGE_META[l.stage].label}</span><span>{l.source.replace('_', ' ')}</span>{l.eventDate && <span class="text-ink-2">· event {l.eventDate}</span>}<a href="/app/customers/leads" class="ml-auto text-brand font-semibold">Open pipeline</a></li>)}
          </ul>
        </section>
      )}

      <section class="card" aria-labelledby="msg-h">
        <header class="px-5 py-4 border-b border-line"><h2 id="msg-h" class="font-bold text-lg">Messages</h2></header>
        {canManage && (
          <form method="post" class="px-5 py-4 border-b border-line space-y-3">
            <input type="hidden" name="_action" value="message" />
            <div class="grid gap-2 sm:grid-cols-[140px_1fr]">
              <div><label class="label" for="channel">Channel</label><select id="channel" name="channel" class="input"><option value="email">Email</option><option value="sms" disabled={!c.phone}>Text{!c.smsOptIn ? ' (not opted in)' : ''}</option></select></div>
              <div><label class="label" for="subject">Subject <span class="font-normal text-ink-2">(email)</span></label><input id="subject" name="subject" class="input" maxlength="150" /></div>
            </div>
            <div><label class="label" for="body">Message</label><textarea id="body" name="body" class="input" rows="3" required></textarea></div>
            <button class="btn-ghost" data-busy-label="Sending…"><Icon name="message" size={16} />Send</button>
          </form>
        )}
        {msgs.length === 0 ? <p class="px-5 py-6 text-sm text-ink-2">No messages yet. Receipts, reminders and campaigns show up here.</p> : (
          <ul class="divide-y divide-line">
            {msgs.map((m) => (
              <li class="px-5 py-3">
                <p class="text-xs text-ink-2"><span class="font-semibold uppercase text-ink">{m.channel}</span> · {m.status} · {dateTime(m.createdAt, tz)}</p>
                {m.subject && <p class="text-sm font-semibold mt-0.5">{m.subject}</p>}
                <p class="text-sm text-ink-2 whitespace-pre-line line-clamp-4">{m.body}</p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>

    <aside>
      <form method="post" class="card p-5 space-y-3">
        <input type="hidden" name="_action" value="save" />
        <h2 class="font-bold text-lg">Profile</h2>
        <div><label class="label" for="name">Name</label><input id="name" name="name" class="input" value={c.name} disabled={!canManage} /></div>
        <div><p class="label">Email</p><p class="text-sm"><a class="text-brand break-all" href={`mailto:${c.email}`}>{c.email}</a></p></div>
        <div><label class="label" for="phone">Phone</label><input id="phone" name="phone" type="tel" class="input" value={c.phone} disabled={!canManage} /></div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="label" for="type">Type</label><select id="type" name="type" class="input" disabled={!canManage}>{CUSTOMER_TYPES.map((x) => <option value={x} selected={x === c.type}>{x[0].toUpperCase() + x.slice(1)}</option>)}</select></div>
          <div><label class="label" for="organization">Organization</label><input id="organization" name="organization" class="input" value={c.organization ?? ''} disabled={!canManage} /></div>
        </div>
        <div><label class="label" for="tags">Tags <span class="font-normal text-ink-2">(comma separated)</span></label><input id="tags" name="tags" class="input" value={c.tags.join(', ')} placeholder="vip, pta, repeat" disabled={!canManage} /></div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="label" for="celebrantName">Birthday kid</label><input id="celebrantName" name="celebrantName" class="input" value={c.celebrantName ?? ''} disabled={!canManage} /></div>
          <div><label class="label" for="celebrantBirthday">Birthday</label><input id="celebrantBirthday" name="celebrantBirthday" type="date" class="input" value={c.celebrantBirthday ?? ''} disabled={!canManage} /></div>
        </div>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="marketingOptIn" checked={c.marketingOptIn} class="accent-brand size-4" disabled={!canManage} />Email marketing opt-in</label>
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="smsOptIn" checked={c.smsOptIn} class="accent-brand size-4" disabled={!canManage} />SMS opt-in</label>
        <div><label class="label" for="cnotes">Notes</label><textarea id="cnotes" name="notes" class="input" rows="3" disabled={!canManage}>{c.notes}</textarea></div>
        {canManage && <button class="btn-primary w-full" data-busy-label="Saving…">Save customer</button>}
      </form>
    </aside>
  </div>
  <SubmitGuard />
</AppLayout>
