---
import { and, eq } from 'drizzle-orm';
import { z } from 'zod';
import AppLayout from '../../../../layouts/AppLayout.astro';
import Icon from '../../../../components/Icon.astro';
import NextSteps from '../../../../components/growth/NextSteps.astro';
import Crumbs from '../../../../components/growth/Crumbs.astro';
import Enhance from '../../../../components/growth/Enhance.astro';
import BlockEditor from '../../../../islands/growth/BlockEditor.tsx';
import { getDb, schema } from '../../../../db/client';
import { formData, str, parse } from '../../../../lib/forms';
import { slugify } from '../../../../lib/util';
import { siteOrigin } from '../../../../lib/tenant';
import { applyTitle } from '../../../../lib/seo';
import { pagePath } from '../../../../lib/growth/blockdefs';
import { scoreCmsPage, scoreTone } from '../../../../lib/growth/seoscore';
import { ctx, done, go, invalid } from '../../../../lib/growth/app';

const { t, tenantId, canEdit } = ctx(Astro);
const id = Astro.params.id ?? '';
if (!z.uuid().safeParse(id).success) return Astro.redirect('/app/website');
const db = await getDb();
const [page] = await db.select().from(schema.pages).where(and(eq(schema.pages.id, id), eq(schema.pages.tenantId, tenantId))).limit(1);
if (!page) return Astro.redirect('/app/website');
const [site] = await db.select().from(schema.sites).where(eq(schema.sites.tenantId, tenantId)).limit(1);
const isHome = page.kind === 'page' && page.slug === '';
const where = and(eq(schema.pages.id, id), eq(schema.pages.tenantId, tenantId));

const Meta = z.object({
  title: z.string().min(3, 'Title is too short').max(120),
  slug: z.string().max(60).regex(/^[a-z0-9-]*$/, 'Use lowercase letters, numbers and dashes'),
  seoTitle: z.string().max(70, 'Keep the SEO title to 70 characters or fewer'),
  seoDescription: z.string().max(170, 'Keep the meta description to 170 characters or fewer'),
});
let errors: Record<string, string> = {};
let values = { title: page.title, slug: page.slug, seoTitle: page.seoTitle ?? '', seoDescription: page.seoDescription ?? '' };
const f = await formData(Astro);
if (f) {
  if (!canEdit) return done(Astro, 'Only owners and managers can edit the website.', undefined, 'error');
  const action = str(f, '_action', 20);
  if (action === 'publish' || action === 'unpublish') {
    if (isHome && action === 'unpublish') return done(Astro, 'Your homepage is always published.', undefined, 'error');
    await db.update(schema.pages).set({ status: action === 'publish' ? 'published' : 'draft', publishedAt: page.publishedAt ?? new Date(), updatedAt: new Date() }).where(where);
    return action === 'publish' ? go(Astro, `/app/website/pages/${id}?done=published`) : done(Astro, 'Unpublished — the page is hidden from your site.');
  }
  values = { title: str(f, 'title', 200), slug: str(f, 'slug', 80), seoTitle: str(f, 'seoTitle', 200), seoDescription: str(f, 'seoDescription', 400) };
  const r = parse(Meta, values);
  if (!r.ok) { errors = r.errors; Astro.response.status = 422; }
  else {
    const slug = isHome ? '' : slugify(r.data.slug || r.data.title);
    const [dupe] = slug !== page.slug ? await db.select({ id: schema.pages.id }).from(schema.pages).where(and(eq(schema.pages.tenantId, tenantId), eq(schema.pages.kind, page.kind), eq(schema.pages.slug, slug))).limit(1) : [];
    if (dupe) { errors.slug = `Another ${page.kind} already uses “${slug}”.`; Astro.response.status = 422; }
    else {
      await db.update(schema.pages).set({ title: r.data.title, slug, seoTitle: r.data.seoTitle || null, seoDescription: r.data.seoDescription || null, updatedAt: new Date() }).where(where);
      return slug !== page.slug && page.status === 'published'
        ? go(Astro, `/app/website/pages/${id}?done=moved&from=${encodeURIComponent(pagePath(page.kind, page.slug))}`)
        : done(Astro, 'Page details saved.');
    }
  }
}

const origin = await siteOrigin(t);
const path = pagePath(page.kind, page.slug);
const previewUrl = origin + path;
const fullTitle = applyTitle(site?.titleTemplate ?? '%s | {business}', values.seoTitle || values.title, t.name);
const desc = values.seoDescription || site?.defaultDescription || '';
const score = scoreCmsPage(page, site, t, { cityCount: 6, categoryCount: 6 });
const KIND_LABEL: Record<string, string> = { page: 'Pages', city: 'City pages', post: 'Blog posts', landing: 'Landing pages' };
const doneKey = Astro.url.searchParams.get('done');
const city = page.local?.city;
---
<AppLayout title={page.title} section="website" subtitle={`${path} · ${page.status === 'published' ? 'Live' : 'Draft — not visible yet'}`} wide>
  <a slot="actions" href={previewUrl} target="_blank" rel="noopener" class="btn-ghost"><Icon name="external" size={16} />Preview</a>
  {canEdit && <form slot="actions" method="post">
    <input type="hidden" name="_action" value={page.status === 'published' ? 'unpublish' : 'publish'} />
    {page.status === 'published' ? (!isHome && <button class="btn-ghost" data-confirm="Unpublish this page? It will disappear from your site.">Unpublish</button>) : <button class="btn-pop" data-busy="Publishing…"><Icon name="bolt" size={16} />Publish</button>}
  </form>}
  <Enhance />
  <Crumbs items={[{ label: 'Website', href: '/app/website' }, { label: KIND_LABEL[page.kind], href: `/app/website?kind=${page.kind}` }, { label: page.title }]} />

  {doneKey === 'created' && (
    <NextSteps title="Draft created" text="It’s hidden until you publish. We’ve added starter blocks — edit the text below, then publish when it reads well." dismissHref={`/app/website/pages/${id}`}
      actions={[
        { href: '#blocks', label: 'Edit the blocks', icon: 'sparkle', primary: true },
        ...(page.kind === 'city' ? [{ href: `/app/seo/city/${id}`, label: 'Add local facts', icon: 'map' }] : [{ href: '#details', label: 'Write the meta description', icon: 'search' }]),
        { href: previewUrl, label: 'Preview draft', icon: 'external', external: true },
      ]} />
  )}
  {doneKey === 'published' && (
    <NextSteps title="Published — it’s live!" text={`Visitors can now reach ${path}.`} dismissHref={`/app/website/pages/${id}`}
      actions={[
        { href: previewUrl, label: 'View live page', icon: 'external', primary: true, external: true },
        city ? { href: `/app/ads?cities=${encodeURIComponent(city)}#build`, label: `Run an ad in ${city}`, icon: 'target' } : { href: `/app/social?occasion=${encodeURIComponent(page.title)}`, label: 'Share on social', icon: 'share' },
        { href: '/app/seo#pages', label: 'See SEO score', icon: 'search' },
      ]} />
  )}
  {doneKey === 'moved' && (
    <NextSteps celebrate={false} title="URL changed" text={`Google and old links still point to ${Astro.url.searchParams.get('from')}. Add a 301 redirect so visitors and rankings follow.`} dismissHref={`/app/website/pages/${id}`}
      actions={[{ href: '/app/seo#migration', label: 'Add the redirect', icon: 'arrow', primary: true }, { href: previewUrl, label: 'View new URL', icon: 'external', external: true }]} />
  )}

  <div class="grid gap-6 xl:grid-cols-[1fr_380px]">
    <section id="blocks" aria-label="Page blocks" class="min-w-0 scroll-mt-24">
      {canEdit ? <BlockEditor client:load pageId={page.id} initial={page.blocks} previewUrl={previewUrl} /> : <p class="card p-6 text-sm">You have view-only access.</p>}
    </section>
    <aside class="space-y-4">
      <form method="post" id="details" class="card p-4 space-y-3 scroll-mt-24" novalidate>
        <h2 class="font-bold">Page details & SEO</h2>
        <input type="hidden" name="_action" value="meta" />
        <div><label class="label" for="title">Title</label><input class="input" id="title" name="title" value={values.title} required maxlength="120" {...invalid(errors, 'title')} />{errors.title && <p id="title-err" class="g-err">{errors.title}</p>}</div>
        {!isHome && <div><label class="label" for="slug">URL slug</label><input class="input font-mono text-xs" id="slug" name="slug" value={values.slug} maxlength="60" {...invalid(errors, 'slug')} />{errors.slug ? <p id="slug-err" class="g-err">{errors.slug}</p> : <p class="hint">Changing a live URL? We’ll remind you to add a redirect.</p>}</div>}
        <div><label class="label" for="seoTitle">SEO title <span class="font-normal text-ink-2" data-count-for="seoTitle">{values.seoTitle.length}/65</span></label><input class="input" id="seoTitle" name="seoTitle" value={values.seoTitle} maxlength="70" placeholder={page.title} data-max="65" {...invalid(errors, 'seoTitle')} />{errors.seoTitle && <p id="seoTitle-err" class="g-err">{errors.seoTitle}</p>}<p class="hint">Lead with the service and city, e.g. “Water Slide Rentals Katy, TX”.</p></div>
        <div><label class="label" for="seoDescription">Meta description <span class="font-normal text-ink-2" data-count-for="seoDescription">{values.seoDescription.length}/160</span></label><textarea class="input" id="seoDescription" name="seoDescription" maxlength="170" rows="3" placeholder={site?.defaultDescription} data-max="160" {...invalid(errors, 'seoDescription')}>{values.seoDescription}</textarea>{errors.seoDescription ? <p id="seoDescription-err" class="g-err">{errors.seoDescription}</p> : <p class="hint">110–160 characters with a call to action (“Check your date online”).</p>}</div>
        {canEdit && <button class="btn-primary w-full" data-busy="Saving…">Save details</button>}
      </form>
      <div class="card p-4">
        <div class="flex items-center gap-2"><h2 class="font-bold text-sm">Google preview</h2><a href="/app/seo#pages" class:list={['ml-auto chip', scoreTone(score.score)]} title="SEO score">SEO {score.score}</a></div>
        <div class="mt-2 rounded-xl border border-line p-3 bg-white">
          <p class="text-xs text-ink-2 truncate">{previewUrl.replace(/^https?:\/\//, '')}</p>
          <p class="text-[#1a0dab] text-base leading-snug mt-0.5 line-clamp-2">{fullTitle}</p>
          <p class="text-xs text-ink-2 mt-1 line-clamp-3">{desc}</p>
        </div>
        <ul class="mt-3 space-y-1 text-xs">
          {score.checks.filter((c) => !c.ok).slice(0, 3).map((c) => <li class="flex gap-1.5 text-ink-2"><Icon name="x" size={12} class="text-danger shrink-0 mt-0.5" />{c.label}</li>)}
        </ul>
      </div>
      {city && (
        <div class="card p-4 space-y-2">
          <h2 class="font-bold text-sm">More for {city}</h2>
          <a class="flex items-center gap-2 text-sm text-brand font-semibold" href={`/app/seo/city/${id}`}><Icon name="map" size={16} />Edit local facts (neighborhoods, parks, FAQs)</a>
          <a class="flex items-center gap-2 text-sm text-brand font-semibold" href={`/app/ads?cities=${encodeURIComponent(city)}#build`}><Icon name="target" size={16} />Build a Google Ads campaign for {city}</a>
          <a class="flex items-center gap-2 text-sm text-brand font-semibold" href={`/app/social?occasion=${encodeURIComponent(`parties in ${city}`)}`}><Icon name="share" size={16} />Post about {city} on social</a>
        </div>
      )}
    </aside>
  </div>
  <script>
    document.querySelectorAll<HTMLElement>('[data-count-for]').forEach((out) => {
      const el = document.getElementById(out.dataset.countFor!) as HTMLInputElement | null;
      if (!el) return;
      const max = Number(el.dataset.max);
      const upd = () => { out.textContent = `${el.value.length}/${max}`; out.classList.toggle('text-danger', el.value.length > max); };
      el.addEventListener('input', upd);
    });
  </script>
</AppLayout>
