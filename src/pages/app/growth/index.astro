---
import { and, eq, ne, or, sql, inArray, desc } from 'drizzle-orm';
import { z } from 'zod';
import AppLayout from '../../../layouts/AppLayout.astro';
import Icon from '../../../components/Icon.astro';
import NextSteps from '../../../components/growth/NextSteps.astro';
import Guide from '../../../components/growth/Guide.astro';
import Enhance from '../../../components/growth/Enhance.astro';
import { getDb, schema } from '../../../db/client';
import { formData, str } from '../../../lib/forms';
import { PLANS, PARTNER_SHARE_BPS, REFERRAL_MONTHS, MARKETPLACE_FEE_BPS } from '../../../lib/plans';
import { operatorEarnings } from '../../../lib/revenue';
import { money } from '../../../lib/pricing';
import { send } from '../../../lib/notify';
import { platformUrl, invalidateTenantCache } from '../../../lib/tenant';
import { rateLimit } from '../../../lib/ratelimit';
import { isValidDay } from '../../../lib/time';
import { ctx, done, go, invalid, fmtDay, pct } from '../../../lib/growth/app';

const { t, tenantId, canEdit } = ctx(Astro);
const db = await getDb();
const P = schema.partnerships;

const Overflow = z.object({
  partnershipId: z.uuid(),
  name: z.string().min(2, 'Customer name is required').max(100),
  email: z.union([z.literal(''), z.email('Enter a valid email')]),
  phone: z.string().max(30),
  eventDate: z.string().refine((d) => d === '' || isValidDay(d), 'Pick a valid date'),
  zip: z.string().regex(/^(\d{5})?$/, 'ZIP must be 5 digits'),
  message: z.string().max(1000),
}).refine((x) => x.email || x.phone, { message: 'Add an email or phone so your partner can reach them', path: ['email'] });

let ovErrors: Record<string, string> = {};
let ovValues: Record<string, string> = { partnershipId: '', name: '', email: '', phone: '', eventDate: '', zip: '', message: '' };
const f = await formData(Astro);
if (f) {
  if (!canEdit) return done(Astro, 'Only owners and managers can manage partnerships.', undefined, 'error');
  const action = str(f, '_action', 20);
  if (action === 'listing') {
    const on = str(f, 'on', 2) === '1';
    await db.update(schema.tenants).set({ marketplaceListed: on, updatedAt: new Date() }).where(eq(schema.tenants.id, tenantId));
    invalidateTenantCache();
    return on ? go(Astro, '/app/growth?done=listed') : done(Astro, 'Hidden from the marketplace and partner search.', '/app/growth#marketplace');
  }
  if (action === 'request') {
    const to = str(f, 'to', 40);
    if (!z.uuid().safeParse(to).success || to === tenantId) return done(Astro, 'Unknown operator.', '/app/growth#partners', 'error');
    if (!rateLimit(`partner-req:${tenantId}`, 10, 1)) return done(Astro, 'Too many requests — try again in a few minutes.', '/app/growth#partners', 'error');
    const [other] = await db.select().from(schema.tenants).where(and(eq(schema.tenants.id, to), eq(schema.tenants.marketplaceListed, true), ne(schema.tenants.status, 'canceled'))).limit(1);
    if (!other) return done(Astro, 'That operator isn’t accepting partners.', '/app/growth#partners', 'error');
    const [row] = await db.insert(P).values({ fromTenantId: tenantId, toTenantId: to, shareBps: PARTNER_SHARE_BPS, status: 'pending' }).onConflictDoNothing().returning();
    if (!row) {
      const [ex] = await db.select().from(P).where(and(eq(P.fromTenantId, tenantId), eq(P.toTenantId, to))).limit(1);
      if (ex?.status === 'declined') { await db.update(P).set({ status: 'pending', createdAt: new Date() }).where(eq(P.id, ex.id)); }
      else return done(Astro, `You already have a ${ex?.status ?? ''} partnership with ${other.name}.`, '/app/growth#partners', 'error');
    }
    if (other.email) await send({ tenantId: other.id, channel: 'email', to: other.email, subject: `${t.name} wants to send you overflow bookings`, body: `${t.name} (${t.city}, ${t.state}) asked to join your BounceOS partner network.\n\nWhen they're sold out, they can pass you customers. You keep the booking; ${t.name} earns ${pct(PARTNER_SHARE_BPS)} of the rental subtotal on bookings that come from their referrals.\n\nAccept or decline: ${platformUrl()}/app/growth#partners` });
    return go(Astro, `/app/growth?done=requested&to=${other.id}`);
  }
  if (action === 'accept' || action === 'decline') {
    const id = str(f, 'id', 40);
    if (!z.uuid().safeParse(id).success) return done(Astro, 'Unknown request.', '/app/growth#partners', 'error');
    // Only the receiving side can accept/decline.
    const [row] = await db.update(P).set({ status: action === 'accept' ? 'active' : 'declined' }).where(and(eq(P.id, id), eq(P.toTenantId, tenantId), eq(P.status, 'pending'))).returning();
    if (!row) return done(Astro, 'That request is no longer pending.', '/app/growth#partners', 'error');
    await db.insert(schema.activity).values({ tenantId, kind: 'partner', message: action === 'accept' ? 'You accepted a new overflow partner.' : 'You declined a partner request.' });
    return action === 'accept' ? go(Astro, `/app/growth?done=accepted&from=${row.fromTenantId}`) : done(Astro, 'Request declined. They won’t be able to send you leads.', '/app/growth#partners');
  }
  if (action === 'end') {
    const id = str(f, 'id', 40);
    if (!z.uuid().safeParse(id).success) return done(Astro, 'Unknown partnership.', '/app/growth#partners', 'error');
    await db.delete(P).where(and(eq(P.id, id), or(eq(P.fromTenantId, tenantId), eq(P.toTenantId, tenantId))));
    return done(Astro, 'Partnership ended.', '/app/growth#partners');
  }
  if (action === 'overflow') {
    ovValues = { partnershipId: str(f, 'partnershipId', 40), name: str(f, 'name', 100), email: str(f, 'email', 200).toLowerCase(), phone: str(f, 'phone', 30), eventDate: str(f, 'eventDate', 10), zip: str(f, 'zip', 5), message: str(f, 'message', 1000) };
    const r = Overflow.safeParse(ovValues);
    if (!r.success) { for (const i of r.error.issues) ovErrors[String(i.path[0] ?? '_')] ??= i.message; Astro.response.status = 422; }
    else {
    if (!rateLimit(`overflow:${tenantId}`, 30, 2)) return done(Astro, 'Slow down — too many leads sent in a short time.', '/app/growth#overflow', 'error');
    const [ps] = await db.select().from(P).where(and(eq(P.id, r.data.partnershipId), eq(P.fromTenantId, tenantId), eq(P.status, 'active'))).limit(1);
    if (!ps) return done(Astro, 'Pick an active partner (they must have accepted your request).', '/app/growth#overflow', 'error');
    const [partner] = await db.select().from(schema.tenants).where(eq(schema.tenants.id, ps.toTenantId)).limit(1);
    if (!partner) return done(Astro, 'Partner not found.', '/app/growth#overflow', 'error');
    await db.insert(schema.leads).values({
      tenantId: partner.id, name: r.data.name, email: r.data.email, phone: r.data.phone, eventDate: r.data.eventDate || null, zip: r.data.zip,
      message: `Overflow referral from ${t.name}. ${r.data.message}`.trim(), source: 'partner', stage: 'new',
      attribution: { utmSource: `partner:${tenantId}`, utmMedium: 'overflow', channel: 'partner', referrer: t.name },
    });
    if (partner.email) await send({ tenantId: partner.id, channel: 'email', to: partner.email, subject: `New overflow lead from ${t.name}: ${r.data.name}`, body: `${t.name} sent you a customer they couldn't serve.\n\nName: ${r.data.name}\nEmail: ${r.data.email || '—'}\nPhone: ${r.data.phone || '—'}\nEvent date: ${r.data.eventDate || '—'}\nZIP: ${r.data.zip || '—'}\n\n${r.data.message}\n\nReach out fast — they're expecting your call. Open it in BounceOS: ${platformUrl()}/app/customers` });
    await db.insert(schema.activity).values({ tenantId, kind: 'partner', message: `You sent ${r.data.name} to ${partner.name}. You'll earn ${pct(ps.shareBps)} if they book.` });
    return go(Astro, `/app/growth?done=overflow&to=${partner.id}&name=${encodeURIComponent(r.data.name)}`);
    }
  }
  else return done(Astro, 'Unknown action.', undefined, 'error');
}

const plan = PLANS[t.plan];
const refLink = `${platformUrl()}/signup?ref=${encodeURIComponent(t.referralCode)}`;
const referred = await db.select({ id: schema.tenants.id, name: schema.tenants.name, plan: schema.tenants.plan, status: schema.tenants.status, createdAt: schema.tenants.createdAt }).from(schema.tenants).where(eq(schema.tenants.referredByTenantId, tenantId)).orderBy(desc(schema.tenants.createdAt)).limit(100);
const earnings = await operatorEarnings(tenantId);
const sum = (k: string) => earnings.filter((e) => e.status === k).reduce((s, e) => s + e.amountCents, 0);
const names = new Map((await db.select({ id: schema.tenants.id, name: schema.tenants.name }).from(schema.tenants).where(inArray(schema.tenants.id, [...new Set(earnings.map((e) => e.tenantId).filter((x): x is string => !!x)), tenantId]))).map((x) => [x.id, x.name]));

const rels = await db.select().from(P).where(or(eq(P.fromTenantId, tenantId), eq(P.toTenantId, tenantId)));
const otherIds = [...new Set(rels.map((r) => (r.fromTenantId === tenantId ? r.toTenantId : r.fromTenantId)))];
const others = new Map((otherIds.length ? await db.select().from(schema.tenants).where(inArray(schema.tenants.id, otherIds)) : []).map((o) => [o.id, o]));
const incoming = rels.filter((r) => r.toTenantId === tenantId && r.status === 'pending');
const outgoingActive = rels.filter((r) => r.fromTenantId === tenantId && r.status === 'active');
const partnerIds = new Set(rels.filter((r) => r.status === 'active').map((r) => (r.fromTenantId === tenantId ? r.toTenantId : r.fromTenantId)));

const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const like = `%${q.replace(/[%_\\]/g, '')}%`;
const found = await db.select({ id: schema.tenants.id, name: schema.tenants.name, city: schema.tenants.city, state: schema.tenants.state, plan: schema.tenants.plan })
  .from(schema.tenants).where(and(ne(schema.tenants.id, tenantId), eq(schema.tenants.marketplaceListed, true), ne(schema.tenants.status, 'canceled'),
    q ? or(sql`${schema.tenants.name} ilike ${like}`, sql`${schema.tenants.city} ilike ${like}`, sql`${schema.tenants.zip} = ${q}`) : sql`${schema.tenants.state} = ${t.state}`)).limit(20);
const relWith = (otherId: string) => rels.filter((r) => (r.fromTenantId === tenantId && r.toTenantId === otherId) || (r.toTenantId === tenantId && r.fromTenantId === otherId));
const [sentLeads] = await db.select({ n: sql<number>`count(*)::int`, won: sql<number>`count(*) filter (where ${schema.leads.stage} = 'won')::int` }).from(schema.leads).where(sql`${schema.leads.attribution}->>'utmSource' = ${'partner:' + tenantId}`);
const [gotLeads] = await db.select({ n: sql<number>`count(*)::int` }).from(schema.leads).where(and(eq(schema.leads.tenantId, tenantId), eq(schema.leads.source, 'partner')));
const doneKey = Astro.url.searchParams.get('done');
const doneOther = others.get(Astro.url.searchParams.get('to') ?? Astro.url.searchParams.get('from') ?? '') ?? found.find((o) => o.id === Astro.url.searchParams.get('to'));
const KIND: Record<string, string> = { referral_commission: 'Referral commission', partner_referral: 'Overflow share' };
const ST: Record<string, string> = { accrued: 'bg-canvas text-ink-2', payable: 'bg-sun/30 text-[#7A5200]', paid: 'bg-green-50 text-green-800', void: 'bg-red-50 text-red-800' };
---
<AppLayout title="Referrals & Partners" section="growth" subtitle="Get paid for spreading the word, and never turn away a sold-out Saturday again.">
  <Enhance />
  {doneKey === 'requested' && (
    <NextSteps title={`Partnership request sent${doneOther ? ` to ${doneOther.name}` : ''}`} text={`What happens next: they get an email and see your request under Referrals & Partners. Once they accept, you can send them overflow leads from this page — and you earn ${pct(PARTNER_SHARE_BPS)} of the rental subtotal on every one that books.`} dismissHref="/app/growth"
      actions={[{ href: '#partners', label: 'See pending requests', icon: 'users', primary: true }, { href: '/app/growth?q=#partners', label: 'Invite another partner', icon: 'plus' }]} />
  )}
  {doneKey === 'accepted' && (
    <NextSteps title={`You’re now partners${doneOther ? ` with ${doneOther.name}` : ''}`} text={`When they’re sold out, their customers come to you as leads (source “partner”). You keep the booking; they earn ${pct(PARTNER_SHARE_BPS)} of the subtotal. Want to send them yours too? Request the reverse partnership.`} dismissHref="/app/growth"
      actions={[{ href: '/app/customers/leads', label: 'Watch for partner leads', icon: 'users', primary: true }, ...(doneOther && !rels.some((r) => r.fromTenantId === tenantId && r.toTenantId === doneOther.id) ? [{ href: '#partners', label: `Request to send leads to ${doneOther.name}`, icon: 'arrow' }] : [])]} />
  )}
  {doneKey === 'overflow' && (
    <NextSteps title={`${(Astro.url.searchParams.get('name') ?? 'Lead').slice(0, 80)} sent${doneOther ? ` to ${doneOther.name}` : ''}`} text={`They got the lead instantly with your name on it. If it turns into a booking, ${pct(PARTNER_SHARE_BPS)} of the rental subtotal is credited to you automatically — watch Earnings below.`} dismissHref="/app/growth"
      actions={[{ href: '#overflow', label: 'Send another', icon: 'arrow', primary: true }, { href: '#referrals', label: 'View earnings', icon: 'dollar' }]} />
  )}
  {doneKey === 'listed' && (
    <NextSteps title="You’re on the BounceOS marketplace" text={`Families searching ZIPs in your delivery zones can now find you and request quotes. Fee: ${pct(MARKETPLACE_FEE_BPS)} only on bookings the marketplace sends you.`} dismissHref="/app/growth"
      actions={[{ href: `/find/${t.zip}`, label: 'See your listing', icon: 'external', primary: true, external: true }, { href: '/app/marketing/reviews', label: 'Add reviews to rank higher', icon: 'star' }]} />
  )}
  <Guide why="Branch Avenue grows when you grow — so the network pays you: commissions for operators you refer, a share when partners book your overflow, and marketplace leads from families searching your ZIPs.">
    <li>Share your referral link in operator Facebook groups and with friends running rental companies.</li>
    <li>Partner with 1–2 nearby operators you trust; overflow only goes where you choose.</li>
    <li>Always ask the customer before passing their details to a partner.</li>
    <li>Shares are tracked automatically from the partner’s booking — no spreadsheets.</li>
    <li>Earnings move from accrued → payable → paid; Branch Avenue pays out monthly.</li>
    <li>Stay listed on the marketplace to receive quote requests from families near you.</li>
  </Guide>
  <nav class="flex gap-1 overflow-x-auto mb-5 -mx-1 px-1 text-sm font-semibold" aria-label="Sections">
    {[['#referrals', 'Referral program'], ['#partners', 'Partner network'], ['#overflow', 'Send overflow lead'], ['#marketplace', 'Marketplace listing']].map(([h, l]) => <a href={h} class="whitespace-nowrap rounded-full px-4 py-2 border border-line bg-white text-ink-2 hover:text-ink">{l}</a>)}
  </nav>

  <div class="grid gap-3 grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="kpi"><p class="kpi-label">Earned (all time)</p><p class="kpi-value text-mint">{money(earnings.filter((e) => e.status !== 'void').reduce((s, e) => s + e.amountCents, 0))}</p></div>
    <div class="kpi"><p class="kpi-label">Pending / payable</p><p class="kpi-value">{money(sum('accrued') + sum('payable'))}</p><p class="hint">{money(sum('payable'))} ready for payout</p></div>
    <div class="kpi"><p class="kpi-label">Operators referred</p><p class="kpi-value">{referred.length}</p></div>
    <div class="kpi"><p class="kpi-label">Overflow leads</p><p class="kpi-value">{sentLeads.n}<span class="text-sm text-ink-2 font-medium"> sent · {gotLeads.n} received</span></p></div>
  </div>

  <section id="referrals" class="grid gap-6 lg:grid-cols-[1fr_1fr] mb-6 scroll-mt-24 items-start">
    <div class="card p-5 sm:p-6 bg-gradient-to-br from-brand to-[#3B22C9] text-white border-brand">
      <p class="chip bg-white/15 text-white">Operator referral program</p>
      <h2 class="text-2xl font-extrabold mt-3 text-white">Earn {pct(plan.referralCommissionBps)} of every referral’s subscription for {REFERRAL_MONTHS} months</h2>
      <p class="text-white/80 text-sm mt-2">Know another rental operator who’s tired of per-item pricing creep? Send them your link. When they subscribe, you earn {pct(plan.referralCommissionBps)} of what they pay — e.g. {money(Math.round(PLANS.pro.monthlyCents * plan.referralCommissionBps / 10_000))}/month for a Pro referral, up to {money(Math.round(PLANS.pro.monthlyCents * plan.referralCommissionBps / 10_000) * REFERRAL_MONTHS)} a year.</p>
      <div class="mt-4 flex gap-2">
        <label class="sr-only" for="reflink">Your referral link</label>
        <input id="reflink" class="input bg-white/95 font-mono text-xs" readonly value={refLink} />
        <button type="button" class="btn-pop shrink-0" data-copy="reflink">Copy</button>
      </div>
      <p class="text-xs text-white/70 mt-2">Code <strong class="font-mono text-white">{t.referralCode}</strong> · paid out once marked payable · referrals must be a different business.</p>
    </div>
    <div class="card overflow-hidden">
      <h2 class="font-bold px-4 py-3 border-b border-line">Earnings</h2>
      {earnings.length === 0 ? (
        <div class="p-5 space-y-3">
          <p class="text-sm text-ink-2">No earnings yet — here’s how they start flowing:</p>
          <ol class="space-y-2 text-sm">
            <li class="flex gap-3 rounded-xl bg-canvas p-3"><span class="grid place-items-center size-7 rounded-full bg-brand text-white text-xs font-bold shrink-0">1</span><span><strong>Share your referral link</strong><span class="block text-xs text-ink-2">A Pro referral pays you {money(Math.round(PLANS.pro.monthlyCents * plan.referralCommissionBps / 10_000))} every month for {REFERRAL_MONTHS} months.</span></span></li>
            <li class="flex gap-3 rounded-xl bg-canvas p-3"><span class="grid place-items-center size-7 rounded-full bg-brand text-white text-xs font-bold shrink-0">2</span><span><strong>Send overflow to a partner</strong><span class="block text-xs text-ink-2">A $300 booking from your lead earns you {money(Math.round(30000 * PARTNER_SHARE_BPS / 10_000))}.</span></span></li>
            <li class="flex gap-3 rounded-xl bg-canvas p-3"><span class="grid place-items-center size-7 rounded-full bg-brand text-white text-xs font-bold shrink-0">3</span><span><strong>Watch it here</strong><span class="block text-xs text-ink-2">Every share moves accrued → payable → paid, paid out monthly.</span></span></li>
          </ol>
          <a href="#overflow" class="btn-ghost w-full">Send an overflow lead</a>
        </div>
      ) : (
        <ul class="sm:hidden divide-y divide-line max-h-80 overflow-y-auto">
          {earnings.slice(0, 50).map((e) => <li class="px-4 py-2.5 flex items-center gap-2 text-sm"><span class="min-w-0 flex-1"><span class="block font-semibold">{KIND[e.kind] ?? e.kind}</span><span class="block text-xs text-ink-2 truncate">{(e.tenantId && names.get(e.tenantId)) ?? '—'} · {fmtDay(e.createdAt, t.timezone)}</span></span><span class="tabular-nums font-bold">{money(e.amountCents)}</span><span class:list={['chip', ST[e.status]]}>{e.status}</span></li>)}
        </ul>
        <div class="relative overflow-x-auto max-h-80 hidden sm:block">
          <table class="table">
            <thead><tr><th>Date</th><th>Type</th><th>From</th><th class="text-right">Amount</th><th>Status</th></tr></thead>
            <tbody>{earnings.slice(0, 50).map((e) => <tr><td class="whitespace-nowrap">{fmtDay(e.createdAt, t.timezone)}</td><td>{KIND[e.kind] ?? e.kind}</td><td class="truncate max-w-40">{(e.tenantId && names.get(e.tenantId)) ?? '—'}</td><td class="text-right tabular-nums font-semibold">{money(e.amountCents)}</td><td><span class:list={['chip', ST[e.status]]}>{e.status}</span></td></tr>)}</tbody>
          </table>
        </div>
      )}
      {referred.length > 0 && <div class="border-t border-line px-4 py-3 text-xs text-ink-2"><span class="font-semibold text-ink">Referred:</span> {referred.map((r) => `${r.name} (${PLANS[r.plan].name}, ${r.status})`).join(' · ')}</div>}
    </div>
  </section>

  <section id="partners" class="grid gap-6 lg:grid-cols-[1fr_380px] mb-6 scroll-mt-24" aria-labelledby="partners-h">
    <div class="card overflow-hidden">
      <div class="px-4 py-3 border-b border-line">
        <h2 id="partners-h" class="font-bold">Partner overflow network</h2>
        <p class="text-xs text-ink-2 mt-0.5">Sold out? Send the customer to a trusted nearby operator instead of saying no. You earn {pct(PARTNER_SHARE_BPS)} of the rental subtotal when they book — tracked automatically.</p>
      </div>
      {incoming.length > 0 && (
        <div class="px-4 py-3 bg-sun/15 border-b border-line space-y-2">
          <p class="text-sm font-semibold">Requests waiting for you</p>
          {incoming.map((r) => { const o = others.get(r.fromTenantId); return (
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class="flex-1 min-w-40"><strong>{o?.name}</strong> <span class="text-ink-2">· {o?.city}, {o?.state} · wants to send you overflow ({pct(r.shareBps)} share to them)</span></span>
              {canEdit && <form method="post"><input type="hidden" name="_action" value="accept" /><input type="hidden" name="id" value={r.id} /><button class="btn-primary min-h-9 px-3 text-xs">Accept</button></form>}
              {canEdit && <form method="post"><input type="hidden" name="_action" value="decline" /><input type="hidden" name="id" value={r.id} /><button class="btn-ghost min-h-9 px-3 text-xs">Decline</button></form>}
            </div>
          ); })}
        </div>
      )}
      <ul class="divide-y divide-line">
        {rels.filter((r) => !(r.toTenantId === tenantId && r.status === 'pending')).map((r) => {
          const out = r.fromTenantId === tenantId; const o = others.get(out ? r.toTenantId : r.fromTenantId);
          return (
            <li class="flex flex-wrap items-center gap-2 px-4 py-3 text-sm">
              <span class="grid place-items-center size-9 rounded-xl bg-canvas shrink-0"><Icon name={out ? 'arrow' : 'gift'} size={16} /></span>
              <span class="flex-1 min-w-40"><strong>{o?.name ?? 'Unknown'}</strong><span class="block text-xs text-ink-2">{out ? `You send them overflow · you earn ${pct(r.shareBps)}` : `They send you overflow · they earn ${pct(r.shareBps)}`} · {o?.city}, {o?.state}</span></span>
              <span class:list={['chip', r.status === 'active' ? 'bg-green-50 text-green-800' : r.status === 'pending' ? 'bg-sun/30 text-[#7A5200]' : 'bg-red-50 text-red-800']}>{r.status === 'pending' ? 'awaiting reply' : r.status}</span>
              {canEdit && <form method="post" data-confirm={r.status === 'pending' ? 'Cancel this partnership request?' : `End your partnership with ${o?.name ?? 'this operator'}? Leads stop flowing both ways for this link.`}><input type="hidden" name="_action" value="end" /><input type="hidden" name="id" value={r.id} /><button class="btn-ghost min-h-9 px-3 text-xs">{r.status === 'pending' ? 'Cancel' : 'End'}</button></form>}
            </li>
          );
        })}
        {rels.length === 0 && <li class="p-4 text-sm text-ink-2">No partners yet — search for operators nearby.</li>}
      </ul>
    </div>
    <div class="card p-4 h-fit">
      <h2 class="font-bold">Find partners</h2>
      <form method="get" action="/app/growth#partners" class="mt-2 flex gap-2" role="search">
        <label class="sr-only" for="q">Search operators</label>
        <input class="input" id="q" name="q" value={q} placeholder="Name, city or ZIP" maxlength="60" />
        <button class="btn-ghost shrink-0" aria-label="Search"><Icon name="search" size={16} /></button>
      </form>
      <p class="hint">{q ? `Results for “${q}”` : `Marketplace-listed operators in ${t.state}`}</p>
      <ul class="mt-2 divide-y divide-line">
        {found.map((o) => {
          const rel = relWith(o.id); const mine = rel.find((r) => r.fromTenantId === tenantId);
          return (
            <li class="py-2.5 flex items-center gap-2 text-sm">
              <span class="flex-1 min-w-0"><span class="block font-semibold truncate">{o.name}</span><span class="block text-xs text-ink-2">{o.city}, {o.state}{partnerIds.has(o.id) ? ' · partner' : ''}</span></span>
              {mine ? <span class="chip bg-canvas text-ink-2">{mine.status}</span>
                : canEdit && <form method="post" data-confirm={`Ask ${o.name} to receive your overflow leads? They’ll get an email.`}><input type="hidden" name="_action" value="request" /><input type="hidden" name="to" value={o.id} /><button class="btn-primary min-h-9 px-3 text-xs" data-busy="Sending…">Request</button></form>}
            </li>
          );
        })}
        {found.length === 0 && <li class="py-3 text-sm text-ink-2">No listed operators found.</li>}
      </ul>
    </div>
  </section>

  <div class="grid gap-6 lg:grid-cols-[1fr_380px]">
    <section id="overflow" class="card p-4 sm:p-6 scroll-mt-24" aria-labelledby="ov-h">
      <h2 id="ov-h" class="font-bold text-lg">Send an overflow lead</h2>
      <p class="text-sm text-ink-2 mt-1">Ask the customer first — then pass their details to a partner who has the date open. The partner gets the lead instantly with your name on it.</p>
      {outgoingActive.length === 0 ? <p class="mt-4 rounded-xl bg-canvas p-4 text-sm text-ink-2">You need an active partner first. Request one on the right — once they accept, you can send leads here.</p> : (
        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-2" novalidate>
          <input type="hidden" name="_action" value="overflow" />
          <div class="sm:col-span-2"><label class="label" for="partnershipId">Partner</label><select class="input" id="partnershipId" name="partnershipId">{outgoingActive.map((r) => <option value={r.id} selected={ovValues.partnershipId === r.id}>{others.get(r.toTenantId)?.name} — you earn {pct(r.shareBps)}</option>)}</select></div>
          <div><label class="label" for="ov-name">Customer name</label><input class="input" id="ov-name" name="name" required maxlength="100" value={ovValues.name} {...invalid(ovErrors, 'name')} aria-describedby={ovErrors.name ? 'name-err' : undefined} />{ovErrors.name && <p id="name-err" class="g-err">{ovErrors.name}</p>}</div>
          <div><label class="label" for="ov-date">Event date</label><input class="input" type="date" id="ov-date" name="eventDate" value={ovValues.eventDate} {...invalid(ovErrors, 'eventDate')} />{ovErrors.eventDate && <p id="eventDate-err" class="g-err">{ovErrors.eventDate}</p>}</div>
          <div><label class="label" for="ov-email">Email</label><input class="input" type="email" id="ov-email" name="email" maxlength="200" value={ovValues.email} {...invalid(ovErrors, 'email')} />{ovErrors.email && <p id="email-err" class="g-err">{ovErrors.email}</p>}</div>
          <div><label class="label" for="ov-phone">Phone</label><input class="input" type="tel" id="ov-phone" name="phone" maxlength="30" value={ovValues.phone} /></div>
          <div><label class="label" for="ov-zip">ZIP</label><input class="input" id="ov-zip" name="zip" inputmode="numeric" maxlength="5" value={ovValues.zip} {...invalid(ovErrors, 'zip')} />{ovErrors.zip && <p id="zip-err" class="g-err">{ovErrors.zip}</p>}</div>
          <div class="sm:col-span-2"><label class="label" for="ov-msg">What they need</label><textarea class="input" id="ov-msg" name="message" rows="3" maxlength="1000" placeholder="Water slide for 25 kids, backyard, 11am–4pm">{ovValues.message}</textarea></div>
          <label class="sm:col-span-2 flex gap-2 text-xs text-ink-2"><input type="checkbox" required class="mt-0.5 accent-[var(--color-brand)]" />The customer agreed to be contacted by my partner.</label>
          <div class="sm:col-span-2"><button class="btn-primary" data-busy="Sending…"><Icon name="arrow" size={16} />Send to partner</button></div>
        </form>
      )}
    </section>

    <section id="marketplace" class="card p-4 sm:p-6 scroll-mt-24 h-fit" aria-labelledby="mk-h">
      <h2 id="mk-h" class="font-bold text-lg">Marketplace listing</h2>
      <p class="text-sm text-ink-2 mt-1">Parents searching <a class="text-brand font-semibold" href={`/find/${t.zip}`} target="_blank">bounceos.com/find</a> see listed operators that deliver to their ZIP and can request quotes from up to three.</p>
      <ul class="text-xs text-ink-2 mt-3 space-y-1">
        <li class="flex gap-2"><Icon name="check" size={14} class="text-mint shrink-0" />Free to list. A {pct(MARKETPLACE_FEE_BPS)} fee applies only to bookings the marketplace sends you.</li>
        <li class="flex gap-2"><Icon name="check" size={14} class="text-mint shrink-0" />0% on bookings from your own website, ads and socials.</li>
        <li class="flex gap-2"><Icon name="check" size={14} class="text-mint shrink-0" />Listing also lets other operators find you as an overflow partner.</li>
      </ul>
      <form method="post" class="mt-4 flex items-center gap-3" data-no-busy data-confirm={t.marketplaceListed ? 'Hide your business from the marketplace and partner search?' : undefined}>
        <input type="hidden" name="_action" value="listing" /><input type="hidden" name="on" value={t.marketplaceListed ? '0' : '1'} />
        <button role="switch" aria-checked={t.marketplaceListed ? 'true' : 'false'} aria-label="Marketplace listing" disabled={!canEdit} class:list={['relative inline-flex h-8 w-14 items-center rounded-full transition-colors cursor-pointer', t.marketplaceListed ? 'bg-mint' : 'bg-line']}>
          <span class:list={['inline-block size-6 rounded-full bg-white shadow transition-transform', t.marketplaceListed ? 'translate-x-7' : 'translate-x-1']}></span>
        </button>
        <span class="text-sm font-semibold">{t.marketplaceListed ? 'Listed' : 'Not listed'}</span>
      </form>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      const el = document.getElementById(b.dataset.copy!) as HTMLInputElement | null;
      if (!el) return;
      try { await navigator.clipboard.writeText(el.value); b.textContent = 'Copied ✓'; } catch { el.select(); }
      setTimeout(() => (b.textContent = 'Copy'), 1600);
    }));
  </script>
</AppLayout>
