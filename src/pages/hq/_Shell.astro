---
/** Branch Avenue HQ shell: platform layout + HQ sub-nav + flash. */
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import Icon from '../../components/Icon.astro';
import Enhance from '../../components/growth/Enhance.astro';
import { readFlash } from '../../lib/forms';
interface Props { title: string; active: 'overview' | 'tenants' | 'ledger' | 'marketplace'; subtitle?: string }
const { title, active, subtitle } = Astro.props;
const flash = readFlash(Astro.cookies);
const tabs = [
  { key: 'overview', href: '/hq', label: 'Overview', icon: 'chart' },
  { key: 'tenants', href: '/hq/tenants', label: 'Tenants', icon: 'users' },
  { key: 'ledger', href: '/hq/ledger', label: 'Revenue ledger', icon: 'dollar' },
  { key: 'marketplace', href: '/hq/marketplace', label: 'Marketplace', icon: 'map' },
];
---
<PlatformLayout title={`${title} · Branch Avenue HQ`} noindex>
  <Enhance />
  <div class="bg-ink text-white">
    <div class="max-w-7xl mx-auto px-4 pt-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-sun">Branch Avenue HQ · platform admin</p>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">{title}</h1>
      {subtitle && <p class="text-sm text-white/65 mt-1">{subtitle}</p>}
      <nav class="mt-4 flex gap-1 overflow-x-auto -mx-1 px-1" aria-label="HQ sections">
        {tabs.map((t) => (
          <a href={t.href} aria-current={active === t.key ? 'page' : undefined} class:list={['flex items-center gap-2 whitespace-nowrap rounded-t-xl px-4 py-2.5 text-sm font-semibold', active === t.key ? 'bg-canvas text-ink' : 'text-white/70 hover:text-white hover:bg-white/10']}><Icon name={t.icon} size={16} />{t.label}</a>
        ))}
      </nav>
    </div>
  </div>
  <div class="bg-canvas min-h-[60vh]">
    <div class="max-w-7xl mx-auto px-4 py-6">
      {flash && <div role="status" class:list={['mb-5 rounded-xl px-4 py-3 text-sm font-medium flex items-center gap-2', flash.kind === 'ok' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200']}><Icon name={flash.kind === 'ok' ? 'check' : 'x'} size={16} />{flash.msg}</div>}
      <slot />
    </div>
  </div>
</PlatformLayout>
