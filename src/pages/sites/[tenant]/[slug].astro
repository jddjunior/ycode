---
/** Generic CMS page/post/landing: faq, about, contact, safety and any operator-created page. */
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Blocks from '../../../components/site/Blocks.astro';
import NotFound from '../../../components/site/NotFound.astro';
import Breadcrumbs from '../../../components/site/Breadcrumbs.astro';
import { loadSiteCtx, loadPage } from '../../../lib/site/data';
import { breadcrumbLd, faqLd } from '../../../lib/seo';

const ctx = await loadSiteCtx(Astro.locals, Astro.params.tenant);
if (!ctx) return new Response('Not found', { status: 404 });
const slug = String(Astro.params.slug ?? '');
const page = slug ? await loadPage(ctx.tenant.id, slug, ['page', 'landing', 'post']) : null;
if (!page) Astro.response.status = 404;
const blocks = page?.blocks ?? [];
const hasHero = blocks[0]?.type === 'hero';
const faqs = blocks.filter((b) => b.type === 'faq').flatMap((b) => (Array.isArray(b.props.faqs) ? (b.props.faqs as { q: string; a: string }[]) : []));
const ld = page ? [
  breadcrumbLd([{ name: 'Home', url: ctx.abs('/') }, { name: page.title, url: ctx.abs(`/${page.slug}`) }]),
  faqLd(faqs),
  page.kind === 'post' ? { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: page.title, datePublished: page.publishedAt?.toISOString(), dateModified: page.updatedAt.toISOString(), author: { '@id': `${ctx.origin}/#business` }, mainEntityOfPage: ctx.abs(`/${page.slug}`) } : null,
] : [];
---
<SiteLayout ctx={ctx} title={page ? (page.seoTitle ?? page.title) : 'Page not found'} description={page?.seoDescription ?? undefined} noindex={!page} ld={ld}>
  {page ? (
    <>
      {!hasHero && (
        <section class="s-hero-bg">
          <div class="s-wrap pt-8 pb-6">
            <Breadcrumbs crumbs={[{ name: 'Home', href: ctx.href('/') }, { name: page.title }]} />
            <h1 class="s-h1 mt-5 !text-[clamp(2rem,5vw,3.4rem)] max-w-3xl">{page.title}</h1>
            {page.kind === 'post' && page.publishedAt && <p class="mt-3 text-sm font-semibold s-sub">{new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(page.publishedAt)}</p>}
          </div>
        </section>
      )}
      <Blocks ctx={ctx} blocks={blocks} pageSlug={page.slug} />
    </>
  ) : <NotFound ctx={ctx} />}
</SiteLayout>
