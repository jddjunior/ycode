---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import Icon from '../components/Icon.astro';
import { PLANS, planList, MARKETPLACE_FEE_BPS, PARTNER_SHARE_BPS, REFERRAL_MONTHS } from '../lib/plans';
import { money } from '../lib/pricing';
import { platformUrl } from '../lib/tenant';

const pct = (b: number) => `${Number((b / 100).toFixed(2))}%`;
const plans = planList();
const lim = (n: number | null) => (n == null ? 'Unlimited' : String(n));
const rows: { label: string; hint?: string; v: (p: (typeof plans)[number]) => string }[] = [
  { label: 'Monthly price', v: (p) => `${money(p.monthlyCents)}/mo` },
  { label: 'Rental items', hint: 'Never priced per item', v: (p) => lim(p.limits.items) },
  { label: 'Team users', v: (p) => lim(p.limits.users) },
  { label: 'City landing pages', v: (p) => lim(p.limits.cityPages) },
  { label: 'AI writing credits / mo', v: (p) => p.limits.aiCredits.toLocaleString() },
  { label: 'Platform fee on online payments', hint: 'Can be passed to customers', v: (p) => pct(p.platformFeeBps) },
  { label: 'Managed ads fee', hint: '% of ad spend, only if you opt in', v: (p) => pct(p.adsManagementBps) },
  { label: 'Marketplace fee', hint: 'Only on marketplace-sent bookings', v: () => pct(MARKETPLACE_FEE_BPS) },
];
const ld = [{ '@context': 'https://schema.org', '@type': 'Product', name: 'BounceOS', brand: { '@type': 'Brand', name: 'Branch Avenue HQ' }, url: platformUrl() + '/pricing',
  offers: plans.map((p) => ({ '@type': 'Offer', name: p.name, price: (p.monthlyCents / 100).toFixed(2), priceCurrency: 'USD' })) }];
---
<PlatformLayout title="Pricing — Flat Plans, No Per-Item Fees | BounceOS" description={`BounceOS plans from ${money(PLANS.starter.monthlyCents)}/mo with unlimited rentals. Transparent platform fees from ${pct(PLANS.elite.platformFeeBps)}, free migration, no setup fees, month to month.`} ld={ld}>
  <section class="max-w-6xl mx-auto px-4 pt-14 pb-8 text-center">
    <p class="chip bg-brand-soft text-brand">Transparent pricing</p>
    <h1 class="mt-3 text-4xl sm:text-6xl font-extrabold leading-tight">One flat price. Every rental included.</h1>
    <p class="mt-4 text-lg text-ink-2 max-w-2xl mx-auto">No per-item pricing, no setup fees, no hosting fees, no surprise “price adjustments”. Month to month — cancel anytime and take your website with you.</p>
  </section>

  <section class="max-w-6xl mx-auto px-4 grid gap-5 md:grid-cols-3">
    {plans.map((p) => (
      <div class:list={['card p-6 sm:p-7 relative flex flex-col', p.id === 'pro' && 'ring-2 ring-brand shadow-xl md:-translate-y-2']}>
        {p.id === 'pro' && <span class="absolute -top-3 left-6 chip bg-brand text-white">Most popular</span>}
        <h2 class="text-2xl font-extrabold">{p.name}</h2>
        <p class="mt-3"><span class="text-5xl font-extrabold font-[family-name:var(--font-display)]">{money(p.monthlyCents).replace('.00', '')}</span><span class="text-ink-2">/month</span></p>
        <p class="text-sm text-ink-2 mt-1">+ {pct(p.platformFeeBps)} platform fee on online payments</p>
        <ul class="mt-6 space-y-2.5 text-sm flex-1">{p.features.map((f) => <li class="flex gap-2"><Icon name="check" size={16} class="text-mint shrink-0 mt-0.5" />{f}</li>)}</ul>
        <a href={`/signup?plan=${p.id}`} class:list={['mt-7 w-full', p.id === 'pro' ? 'btn-primary' : 'btn-ghost']}>Start 30-day free trial</a>
      </div>
    ))}
  </section>

  <section class="max-w-6xl mx-auto px-4 py-14">
    <div class="rounded-3xl bg-ink text-white p-6 sm:p-10 grid gap-6 md:grid-cols-[1fr_1.2fr] items-center">
      <div>
        <h2 class="text-3xl font-extrabold text-white">No per-item pricing. Ever.</h2>
        <p class="text-white/75 mt-3">Some rental platforms charge by how many units you own — one top tier adds $25 for every 50 extra items. That turns every new bounce house into a software bill. BounceOS plans include unlimited inventory, add-ons and packages.</p>
        <p class="text-xs text-white/50 mt-3">Competitor figures from public pricing pages as of 2026.</p>
      </div>
      <div class="grid grid-cols-3 gap-3 text-center">
        {[['10 units', '$0'], ['60 units', '$0'], ['300 units', '$0']].map(([u, extra]) => (
          <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/15"><p class="text-sm text-white/70">{u}</p><p class="text-3xl font-extrabold text-sun mt-1 font-[family-name:var(--font-display)]">{extra}</p><p class="text-xs text-white/60">extra per month</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-extrabold">Every fee, in one table</h2>
    <p class="text-ink-2 mt-1">What Branch Avenue earns, and when. Nothing else is charged.</p>
    <!-- Mobile: cards -->
    <div class="mt-6 grid gap-4 md:hidden">
      {plans.map((p) => (
        <div class="card p-4"><h3 class="font-extrabold text-lg">{p.name}</h3>
          <dl class="mt-2 divide-y divide-line text-sm">{rows.map((r) => <div class="flex justify-between gap-3 py-2"><dt class="text-ink-2">{r.label}</dt><dd class="font-semibold text-right">{r.v(p)}</dd></div>)}</dl>
        </div>
      ))}
    </div>
    <div class="mt-6 card overflow-hidden hidden md:block">
      <table class="table">
        <thead><tr><th class="w-2/5">&nbsp;</th>{plans.map((p) => <th class="text-center">{p.name}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr><td><span class="font-semibold">{r.label}</span>{r.hint && <span class="block text-xs text-ink-2">{r.hint}</span>}</td>{plans.map((p) => <td class="text-center tabular-nums font-semibold">{r.v(p)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3 text-sm">
      <div class="card p-5"><Icon name="dollar" class="text-brand" /><p class="font-bold mt-2">Platform fee</p><p class="text-ink-2 mt-1">A small % of online card payments funds unlimited items and users. Prefer not to absorb it? Turn on “pass fee to customer” and it’s shown as a booking fee at checkout. Cash, check and offline payments are never charged.</p></div>
      <div class="card p-5"><Icon name="map" class="text-brand" /><p class="font-bold mt-2">Marketplace & partners</p><p class="text-ink-2 mt-1">Listing is free. {pct(MARKETPLACE_FEE_BPS)} applies only to bookings the BounceOS marketplace sends you — 0% on your own customers. Overflow partners set a {pct(PARTNER_SHARE_BPS)} share by default, paid to the operator who sent the booking.</p></div>
      <div class="card p-5"><Icon name="gift" class="text-brand" /><p class="font-bold mt-2">Referrals pay you</p><p class="text-ink-2 mt-1">Refer another operator and earn {pct(PLANS.pro.referralCommissionBps)} of their subscription for {REFERRAL_MONTHS} months — tracked in your dashboard ledger.</p></div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-extrabold text-center">Pricing FAQ</h2>
    <div class="mt-6 divide-y divide-line border-y border-line">
      {[
        ['Is there a setup or hosting fee?', 'No. Your website, custom domain, SSL and hosting are included on every plan.'],
        ['Can I change plans later?', 'Yes — upgrade or downgrade any time from Settings → Billing.'],
        ['What happens when the trial ends?', 'Choose a plan to keep going. If you don’t, your account pauses and you can still export your data.'],
        ['Do you take a cut of my bookings?', `Only the platform fee on online payments (${pct(PLANS.elite.platformFeeBps)}–${pct(PLANS.starter.platformFeeBps)}), plus the marketplace fee on bookings our marketplace sends you. Card processing is billed by Stripe at their standard rate.`],
        ['Is managed advertising required?', 'No. Build and export Google Ads campaigns yourself for free, or let our team manage them for a % of spend. Ad spend is paid directly to Google or Meta.'],
      ].map(([q, a]) => (
        <details class="group py-4"><summary class="flex items-center gap-3 cursor-pointer list-none font-bold">{q}<span class="ml-auto grid place-items-center size-8 rounded-full bg-canvas transition-transform group-open:rotate-45 shrink-0"><Icon name="plus" size={16} /></span></summary><p class="mt-2 text-ink-2">{a}</p></details>
      ))}
    </div>
    <div class="mt-10 text-center"><a href="/signup" class="btn-pop min-h-12 px-6 rounded-2xl text-base">Start your free trial</a><p class="text-sm text-ink-2 mt-3">Switching? <a class="text-brand font-semibold" href="/compare">See how we compare</a></p></div>
  </section>
</PlatformLayout>
